<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\SoliBee.Core\SoliBee.Core.csproj" />
  </ItemGroup>

  <!-- SoliBee.Core.Services.BannerCatalog reads Assets/HoneycombBannerCatalog.json as a
       plain file next to the running executable (AppContext.BaseDirectory) — needed here
       too so HoneycombBannerTriggerTests.cs can exercise real banner-catalog lookups,
       not just banner queue plumbing. References the canonical copy in SoliBee.Desktop
       rather than duplicating it. -->
  <ItemGroup>
    <Content Include="..\..\src\SoliBee.Desktop\Assets\HoneycombBannerCatalog.json" Link="Assets\HoneycombBannerCatalog.json" CopyToOutputDirectory="Always" />
  </ItemGroup>

</Project>
