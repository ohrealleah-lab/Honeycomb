# Root-level ignores — mac/ and windows/ have their own more specific .gitignore files
.DS_Store
.build/
.swiftpm/

# iOS: Honeycomb.xcodeproj is generated from ios/project.yml — run `xcodegen generate` in ios/
ios/Honeycomb.xcodeproj/
ios/build/

# Temporary copy `make test` places next to the test runner (removed after the run)
mac/HoneycombBannerCatalog.json
mac/test_runner

# Coverage output from `make test COVERAGE=1`
mac/coverage.lcov
mac/coverage.profraw
mac/coverage.profdata
