<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:SoliBee.Desktop.Views"
             x:Class="SoliBee.Desktop.Views.PreferencesView">

    <UserControl.Styles>
        <!-- FluentTheme's default CheckBox template tints the label's ContentPresenter
             on hover — pin it to stay dark, matching this panel's light background. -->
        <Style Selector="CheckBox:pointerover /template/ ContentPresenter">
            <Setter Property="Foreground" Value="#1A1A1A"/>
        </Style>

        <!-- Same FluentTheme pointerover-tint issue as MainWindow's light-secondary/
             light-primary/light-danger classes, for the two Themes-page buttons with
             their own distinct look (subcard nav row, transparent back link). -->
        <Style Selector="Button.theme-nav">
            <Setter Property="Background" Value="#F2F2F2"/>
        </Style>
        <Style Selector="Button.theme-nav:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#F2F2F2"/>
        </Style>
    </UserControl.Styles>

    <Grid>

        <!-- ═══════════════════════════════════════════════════════════════════
             MAIN OPTIONS PANEL
             ═══════════════════════════════════════════════════════════════════ -->
        <StackPanel x:Name="MainPanel" Spacing="12" Width="460" Margin="10,10,20,10">

            <StackPanel.Styles>
                <Style Selector="CheckBox">
                    <Setter Property="Padding" Value="6,0,0,0" />
                    <Setter Property="MinHeight" Value="24" />
                </Style>
            </StackPanel.Styles>

            <!-- Game Mode + Vegas Scoring — the only two settings that actually vary per
                 game: Game Mode (Klondike/Freecell/Spider only — draw count / deck count /
                 suit count) and Vegas Scoring (Klondike only). Whole section is hidden when
                 neither applies (Honeycomb/Video Poker/Blackjack) via
                 RefreshThisGameSectionVisibility() in the code-behind — no header of its
                 own, so there's nothing left to hide alongside it. -->
            <StackPanel x:Name="ThisGameSection" Spacing="6">
                <StackPanel x:Name="GameModeSection" IsVisible="False" Spacing="6">
                    <TextBlock x:Name="GameModeSectionHeaderText" Text="Game Mode" FontSize="12" Foreground="#1A1A1A"/>
                    <ComboBox x:Name="GameModeCombo" HorizontalAlignment="Stretch"
                              SelectionChanged="GameMode_Changed"/>
                </StackPanel>

                <CheckBox x:Name="VegasCheckBox" Content="Vegas Scoring" Checked="Option_Changed" Unchecked="Option_Changed" Foreground="#1A1A1A"/>

                <Rectangle Height="1" Fill="#DDDDDD" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- Video Poker's own per-game settings — Starting Credits/Default Bet.
                 (Variant is set directly on the board, not here.) Mac/iOS have always had
                 Starting Credits/Default Bet; the Windows port had the localization strings
                 scaffolded but the actual controls were never added. Shown only when
                 DataContext is VideoPokerOptions (SyncUIFromVideoPokerOptions/
                 SyncUIFromOptions/SyncUIFromBlackjackOptions each set this section's
                 visibility). -->
            <StackPanel x:Name="VideoPokerOptionsSection" IsVisible="False" Spacing="6">
                <TextBlock x:Name="StartingCreditsLabel" Text="Starting Credits:" FontSize="12" Foreground="#1A1A1A"/>
                <!-- ClipValueToMinMax: Avalonia's NumericUpDown does not clamp a directly-
                     typed value to Minimum/Maximum by default (only the spin buttons
                     respect the bounds) — without this, typing e.g. "50" would persist an
                     out-of-range StartingCredits with nothing downstream to catch it. -->
                <NumericUpDown x:Name="StartingCreditsUpDown" Minimum="100" Maximum="10000" Increment="100"
                               ClipValueToMinMax="True"
                               FormatString="0" HorizontalAlignment="Stretch"
                               ValueChanged="StartingCredits_ValueChanged"/>

                <TextBlock x:Name="DefaultBetLabel" Text="Default Bet:" FontSize="12" Foreground="#1A1A1A" Margin="0,4,0,0"/>
                <ComboBox x:Name="DefaultBetComboBox" HorizontalAlignment="Stretch" SelectionChanged="VideoPokerOption_Changed">
                    <ComboBoxItem x:Name="DefaultBet1Item" Content="1 coin" Tag="1"/>
                    <ComboBoxItem x:Name="DefaultBet2Item" Content="2 coins" Tag="2"/>
                    <ComboBoxItem x:Name="DefaultBet3Item" Content="3 coins" Tag="3"/>
                    <ComboBoxItem x:Name="DefaultBet4Item" Content="4 coins" Tag="4"/>
                    <ComboBoxItem x:Name="DefaultBet5Item" Content="5 coins" Tag="5"/>
                </ComboBox>

                <Rectangle Height="1" Fill="#DDDDDD" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- "Global Settings" — every field below is confirmed shared/global across
                 all 6 games (each VP/Blackjack sync method reads it from the shared
                 GameOptions, not their own local Options). Checkboxes run in two side-by-
                 side stacks instead of one long column — MainPanel's Width above is sized
                 to fit both columns without wrapping. -->
            <StackPanel Spacing="6">
                <TextBlock x:Name="GlobalSettingsHeaderText" Text="Global Settings" FontSize="13" FontWeight="SemiBold" Foreground="#1A1A1A"/>

                <ComboBox x:Name="LanguageComboBox" HorizontalAlignment="Stretch"
                          SelectionChanged="Language_Changed">
                    <ComboBoxItem x:Name="EnglishLanguageItem" Content="English / Inglés" Tag="English"/>
                    <ComboBoxItem x:Name="SpanishLanguageItem" Content="Spanish / Español" Tag="Spanish"/>
                </ComboBox>

                <Grid ColumnDefinitions="*,20,*" Margin="0,4,0,0">
                    <StackPanel Grid.Column="0" Spacing="2">
                        <CheckBox x:Name="SoundCheckBox"        Content="Sound Effects"      Checked="Option_Changed" Unchecked="Option_Changed" Foreground="#1A1A1A"/>
                        <CheckBox x:Name="NoStressModeCheckBox" Content="No Stress Mode"     Checked="Option_Changed" Unchecked="Option_Changed" Foreground="#1A1A1A"/>
                        <CheckBox x:Name="HideHintCheckBox"  Content="Hide Hint button"  Checked="Option_Changed" Unchecked="Option_Changed" Foreground="#1A1A1A"/>
                        <!-- Banners/toasts stay up until the player clicks the toast or a
                             card, instead of auto-dismissing. -->
                        <CheckBox x:Name="ManuallyDismissBannersCheckBox" Content="Manually Dismiss Banners" Checked="Option_Changed" Unchecked="Option_Changed" Foreground="#1A1A1A"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Spacing="2">
                        <CheckBox x:Name="AlwaysOnTopCheckBox" Content="Always on Top" Checked="Option_Changed" Unchecked="Option_Changed" Foreground="#1A1A1A"/>
                        <!-- Controls both the "+N"/"-N" score popups and whether Repeatable
                             Flavor/Ambiance banners fire at all. -->
                        <CheckBox x:Name="PointHighlightsCheckBox" Content="Honey Mode (Flavor)" Checked="Option_Changed" Unchecked="Option_Changed" Foreground="#1A1A1A"/>
                        <CheckBox x:Name="HideBeeCheckBox" Content="Hide the Bee" Checked="Option_Changed" Unchecked="Option_Changed" Foreground="#1A1A1A"/>
                    </StackPanel>
                </Grid>
            </StackPanel>

            <!-- TEMPORARY — dev calibration for the bee watermark's per-game scale/position.
                 Delete this StackPanel + the WatermarkXSlider_ValueChanged handlers below
                 once final per-game values are known (see GetWatermarkScale/SetWatermarkScale
                 and friends), same as the removal this redoes (see c4e5ab8). Each slider's
                 own TextBlock shows the live numeric value, since eyeballing a bare slider
                 thumb position isn't precise enough to transcribe into GameOptions' defaults. -->
            <StackPanel x:Name="WatermarkScaleSection" Spacing="4">
                <TextBlock Text="Bee Watermark Scale (temporary — dev calibration)" FontSize="11" Foreground="#1A1A1A"/>
                <Grid ColumnDefinitions="*,50">
                    <Slider Grid.Column="0" x:Name="WatermarkScaleSlider"
                            ValueChanged="WatermarkScaleSlider_ValueChanged"/>
                    <TextBlock Grid.Column="1" x:Name="WatermarkScaleValueText" FontSize="11" Foreground="#1A1A1A"
                               VerticalAlignment="Center" HorizontalAlignment="Right"/>
                </Grid>
                <TextBlock Text="Bee Watermark Horizontal Position (temporary — dev calibration)" FontSize="11" Foreground="#1A1A1A"/>
                <Grid ColumnDefinitions="*,50">
                    <Slider Grid.Column="0" x:Name="WatermarkOffsetXSlider" Minimum="-500" Maximum="500"
                            ValueChanged="WatermarkOffsetXSlider_ValueChanged"/>
                    <TextBlock Grid.Column="1" x:Name="WatermarkOffsetXValueText" FontSize="11" Foreground="#1A1A1A"
                               VerticalAlignment="Center" HorizontalAlignment="Right"/>
                </Grid>
                <TextBlock Text="Bee Watermark Vertical Position (temporary — dev calibration)" FontSize="11" Foreground="#1A1A1A"/>
                <Grid ColumnDefinitions="*,50">
                    <Slider Grid.Column="0" x:Name="WatermarkOffsetYSlider" Minimum="-500" Maximum="500"
                            ValueChanged="WatermarkOffsetYSlider_ValueChanged"/>
                    <TextBlock Grid.Column="1" x:Name="WatermarkOffsetYValueText" FontSize="11" Foreground="#1A1A1A"
                               VerticalAlignment="Center" HorizontalAlignment="Right"/>
                </Grid>
            </StackPanel>

            <Rectangle x:Name="VisualThemesDivider" Height="1" Fill="#DDDDDD" Margin="0,4,0,4"/>

            <!-- Themes navigation row (not applicable to Video Poker) -->
            <Button x:Name="VisualThemesButton" Click="OpenThemes_Click"
                    Classes="theme-nav" Foreground="#1A1A1A"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                    Padding="12,10" CornerRadius="6"
                    BorderThickness="1" BorderBrush="#DDDDDD">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="3">
                        <TextBlock x:Name="VisualThemesLabel" Text="Visual Themes" FontSize="14" FontWeight="SemiBold" Foreground="#1A1A1A"/>
                        <TextBlock x:Name="VisualThemesSubtitleLabel" Text="Felt, card back, face card art, colors" FontSize="11" Foreground="#1A1A1A"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="›" FontSize="20" Foreground="#1A1A1A" VerticalAlignment="Center" Margin="0,0,4,0"/>
                </Grid>
            </Button>

            <Rectangle Height="1" Fill="#DDDDDD" Margin="0,4,0,4"/>

            <!-- Help & About -->
            <Button x:Name="HelpGuideButton" Content="Help Guide" Click="Help_Click" Classes="light-secondary"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />

            <Button x:Name="AboutHoneycombButton" Content="About Honeycomb" Click="About_Click" Classes="light-secondary"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                    Margin="0,4,0,0" />
        </StackPanel>

        <!-- ═══════════════════════════════════════════════════════════════════
             THEMES SUB-PANEL
             ═══════════════════════════════════════════════════════════════════ -->
        <Grid x:Name="ThemesPanel" IsVisible="False" Width="770" Margin="10,10,10,10" RowDefinitions="*" ColumnDefinitions="180,*">

            <!-- Sidebar: Saved Themes — its own persistent column, not part of the
                 scrolling settings, so it stays visible as a picker while the rest
                 of the panel scrolls independently. Tinted background + divider so
                 it reads as a distinct panel instead of blending into the settings. -->
            <Border Grid.Row="0" Grid.Column="0" Background="#ECECEC" BorderBrush="#DCDCDC" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,10,0">
                <Grid RowDefinitions="Auto,Auto,*">
                    <TextBlock Grid.Row="0" x:Name="SavedThemesHeaderText" Text="Saved Themes" FontWeight="Bold" Foreground="#1A1A1A" Margin="0,4,0,0"/>

                    <Button Grid.Row="1" x:Name="SaveThemeButton" Content="Save New Theme…"
                            Click="SaveTheme_Click"
                            Classes="light-primary"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                            Margin="0,8,0,8"/>

                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                        <StackPanel Spacing="4" HorizontalAlignment="Stretch">
                            <StackPanel x:Name="ThemeListPanel" Spacing="2" HorizontalAlignment="Stretch"/>
                            <TextBlock x:Name="NoThemesLabel" Text="No saved themes yet." FontSize="11" Foreground="#1A1A1A"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <Rectangle Grid.Row="0" Grid.Column="0" Width="1" Fill="#E0E0E0" HorizontalAlignment="Right"/>

            <!-- Settings column — hero preview on top, Card Deck/Background side by
                 side underneath, then the two full-width nav buttons. -->
            <StackPanel Grid.Row="0" Grid.Column="1" Spacing="14" Margin="10,0,0,0">

                <!-- ─── Card + Background mockup (hero preview) ───────────────── -->
                <!-- The actual configured card back rendered on the actual configured
                     backdrop (felt color, or the real background image when one is
                     set — no dominant-color sampling here, unlike the Custom Card
                     Colors preview, since the real image is directly visible and
                     meaningful in this context). Double-click the card or the
                     background to adjust either. -->
                <Border x:Name="DeckBackgroundBackdrop" Height="210" CornerRadius="10"
                        ClipToBounds="True" HorizontalAlignment="Stretch"
                        Cursor="Hand" DoubleTapped="DeckBackgroundBackdrop_DoubleTapped"
                        ToolTip.Tip="Double-click the card or the background to adjust it">
                    <Grid>
                        <Image x:Name="DeckBackgroundImage" Stretch="UniformToFill" IsVisible="False"
                               RenderOptions.BitmapInterpolationMode="HighQuality"/>
                        <ContentControl x:Name="DeckBackgroundCardMockHost" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- ─── Card Deck / Background, side by side ──────────────────── -->
                <Grid ColumnDefinitions="*,16,*" Margin="0,10,0,0">

                    <!-- Card Deck -->
                    <StackPanel Grid.Column="0" Spacing="6">
                        <TextBlock x:Name="CardDeckHeadingText" Text="Card Deck" FontWeight="Bold" Foreground="#1A1A1A" Height="24" VerticalAlignment="Center"/>

                        <ComboBox x:Name="CardBackComboBox" Classes="pill" HorizontalAlignment="Stretch" SelectionChanged="CardBackComboBox_SelectionChanged">
                            <ComboBoxItem Content="Vulpera" Tag="Vulpera"/>
                            <ComboBoxItem Content="Moogle"   Tag="Moogle"/>
                        </ComboBox>
                        <Grid ColumnDefinitions="*, *">
                            <Button x:Name="AddCustomCardBackButton"    Grid.Column="0" Content="Add…"  Click="AddCustomCardBack_Click"    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Classes="light-secondary" Margin="0,0,2,0"/>
                            <Button x:Name="DeleteCustomCardBackButton" Grid.Column="1" Content="Delete" Click="DeleteCustomCardBack_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Classes="light-danger" Margin="2,0,0,0" IsEnabled="False"/>
                        </Grid>
                    </StackPanel>

                    <!-- Background — Felt Color and image Background merged into one
                         section since both control what's behind the cards, and the
                         hero preview above already shows the felt color whenever no
                         background image is set, so they read as one concept anyway. -->
                    <StackPanel Grid.Column="2" Spacing="6">
                        <Grid ColumnDefinitions="*,Auto" Height="24">
                            <TextBlock Grid.Column="0" x:Name="BackgroundSectionHeaderText" Text="Background" FontWeight="Bold" Foreground="#1A1A1A" VerticalAlignment="Center"/>
                            <!-- Inline with the header (instead of its own row below) and
                                 scaled down — it's a minor toggle, not a primary control,
                                 so it shouldn't take the same visual weight as the dropdown
                                 or Add/Delete buttons. LayoutTransformControl (not
                                 RenderTransform) so the shrink actually reduces the space
                                 this reserves in the Grid, instead of just visually
                                 scaling a control that still claims its full unscaled
                                 layout size — that was clipping the checkbox glyph. Row
                                 height matches Card Deck's header exactly (24) so both
                                 columns' dropdowns/buttons stay aligned regardless of the
                                 checkbox's own natural size. -->
                            <LayoutTransformControl Grid.Column="1" VerticalAlignment="Center">
                                <LayoutTransformControl.LayoutTransform>
                                    <ScaleTransform ScaleX="0.8" ScaleY="0.8"/>
                                </LayoutTransformControl.LayoutTransform>
                                <CheckBox x:Name="VignetteCheckBox" Content="Felt Vignette" FontSize="11"
                                          Checked="Option_Changed" Unchecked="Option_Changed" Foreground="#1A1A1A"
                                          Padding="4,0,0,0"/>
                            </LayoutTransformControl>
                        </Grid>

                        <!-- Felt presets and background images share one dropdown — fully
                             populated in code-behind (PopulateBackgrounds), including a
                             disabled separator row between the two groups. -->
                        <ComboBox x:Name="BackgroundComboBox" Classes="pill" HorizontalAlignment="Stretch" SelectionChanged="BackgroundComboBox_SelectionChanged"/>

                        <!-- Custom felt color lives in a popover instead of an inline
                             expanding panel, so picking "Custom Color" doesn't push the
                             rest of the layout down. -->
                        <Button x:Name="CustomColorPanel" Content="Choose Custom Color…"
                                Classes="light-secondary" HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center" IsVisible="False">
                            <Button.Flyout>
                                <Flyout>
                                    <ColorPicker x:Name="FeltColorPicker" ColorChanged="FeltColorPicker_ColorChanged"/>
                                </Flyout>
                            </Button.Flyout>
                        </Button>

                        <Grid ColumnDefinitions="*, *">
                            <Button x:Name="AddCustomBackgroundButton"    Grid.Column="0" Content="Add…"  Click="AddCustomBackground_Click"    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Classes="light-secondary" Margin="0,0,2,0"/>
                            <Button x:Name="DeleteCustomBackgroundButton" Grid.Column="1" Content="Delete" Click="DeleteCustomBackground_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Classes="light-danger" Margin="2,0,0,0" IsEnabled="False"/>
                        </Grid>
                    </StackPanel>

                </Grid>

                <!-- The 16-slot grid needs more room than this column can give it —
                     opened as a full-width sub-panel instead of crammed in here. -->
                <Button x:Name="FaceCardsButton" Click="OpenFaceCards_Click"
                        Classes="theme-nav" Foreground="#1A1A1A"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                        Padding="12,10" CornerRadius="6"
                        BorderThickness="1" BorderBrush="#DDDDDD">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Spacing="3">
                            <TextBlock x:Name="FaceCardsButtonTitleText" Text="Customize Face Cards for Theme" FontSize="14" FontWeight="SemiBold" Foreground="#1A1A1A"/>
                            <TextBlock x:Name="FaceCardsButtonSubtitleText" Text="16 slots — Aces, Jacks, Queens, Kings per suit" FontSize="11" Foreground="#1A1A1A"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="›" FontSize="20" Foreground="#1A1A1A" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    </Grid>
                </Button>

                <!-- Card colors need a live preview against real cards/the theme's
                     backdrop to be meaningful — opened as its own sub-panel instead of
                     just swatch chips in this column. -->
                <Button x:Name="CardColorsButton" Click="OpenCardColorsPanel_Click"
                        Classes="theme-nav" Foreground="#1A1A1A"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                        Padding="12,10" CornerRadius="6"
                        BorderThickness="1" BorderBrush="#DDDDDD">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Spacing="3">
                            <TextBlock x:Name="CardColorsButtonTitleText" Text="Custom Card Colors for Theme" FontSize="14" FontWeight="SemiBold" Foreground="#1A1A1A"/>
                            <TextBlock x:Name="CardColorsButtonSubtitleText" Text="Background, outline, text, hint highlight" FontSize="11" Foreground="#1A1A1A"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="›" FontSize="20" Foreground="#1A1A1A" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    </Grid>
                </Button>

            </StackPanel>

        </Grid>

        <!-- ═══════════════════════════════════════════════════════════════════
             FACE CARDS SUB-PANEL — full width so the 16-slot grid isn't
             squeezed into a ~270px column alongside every other setting.
             ═══════════════════════════════════════════════════════════════════ -->
        <Grid x:Name="FaceCardsPanel" IsVisible="False" Width="770" Margin="10,10,10,10" RowDefinitions="*">

            <!-- Constrained watermark (matches HoneycombRulesView/MainWindow/ManageDecksView's
                 treatment) — fixed max size rather than left to scale with the panel, so it
                 sits behind the content instead of overpowering it. -->
            <Image Source="avares://Honeycomb/Assets/solibee.png" Opacity="0.15" Stretch="Uniform"
                   MaxWidth="400" MaxHeight="400" HorizontalAlignment="Center" VerticalAlignment="Center"
                   Grid.Row="0" IsHitTestVisible="False"
                   IsVisible="{Binding !HideBee}" />

            <StackPanel Grid.Row="0" Spacing="6">
                <TextBlock x:Name="TapTileHintText" Text="Tap a tile to upload art. Tap again to adjust." FontSize="12" Foreground="#1A1A1A"/>
                <v:FaceCardArtSectionView/>
            </StackPanel>

        </Grid>

        <!-- ═══════════════════════════════════════════════════════════════════
             CUSTOM CARD COLORS SUB-PANEL — live 3-card preview against the
             theme's own backdrop, plus the 5 color pickers.
             ═══════════════════════════════════════════════════════════════════ -->
        <Grid x:Name="CardColorsPanel" IsVisible="False" Width="770" Margin="10,10,10,10" RowDefinitions="Auto,*">

            <Border x:Name="CardColorPreviewBackdrop" Grid.Row="0" Height="240" CornerRadius="8" Padding="20" Margin="0,0,0,14" ClipToBounds="True">
                <Grid>
                    <Image x:Name="CardColorPreviewImage" Stretch="UniformToFill" IsVisible="False"
                           RenderOptions.BitmapInterpolationMode="HighQuality"/>
                    <StackPanel x:Name="CardColorPreviewStack" Orientation="Horizontal" Spacing="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <StackPanel Grid.Row="1" Spacing="8">
                <TextBlock x:Name="CustomCardColorsPanelTitleText" Text="Custom Card Colors" FontWeight="Bold" Foreground="#1A1A1A"/>
                <Rectangle Height="1" Fill="#E5E5E5"/>

                <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnDefinitions="*,Auto" Margin="0,4,0,4">
                    <TextBlock Grid.Row="0" Grid.Column="0" x:Name="CardBackgroundColorLabelText" Text="Card Background:" VerticalAlignment="Center" Foreground="#1A1A1A"/>
                    <ColorPicker Grid.Row="0" Grid.Column="1" x:Name="CardBgColorPicker" ColorChanged="CardColorPicker_ColorChanged" HorizontalAlignment="Right" Margin="0,2,0,2"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" x:Name="CardOutlineColorLabelText" Text="Card Outline:" VerticalAlignment="Center" Foreground="#1A1A1A"/>
                    <ColorPicker Grid.Row="1" Grid.Column="1" x:Name="CardOutlineColorPicker" ColorChanged="CardColorPicker_ColorChanged" HorizontalAlignment="Right" Margin="0,2,0,2"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" x:Name="BlackSuitTextColorLabelText" Text="Text (Black Suits):" VerticalAlignment="Center" Foreground="#1A1A1A"/>
                    <ColorPicker Grid.Row="2" Grid.Column="1" x:Name="CardTextBlackColorPicker" ColorChanged="CardColorPicker_ColorChanged" HorizontalAlignment="Right" Margin="0,2,0,2"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" x:Name="RedSuitTextColorLabelText" Text="Text (Red Suits):" VerticalAlignment="Center" Foreground="#1A1A1A"/>
                    <ColorPicker Grid.Row="3" Grid.Column="1" x:Name="CardTextRedColorPicker" ColorChanged="CardColorPicker_ColorChanged" HorizontalAlignment="Right" Margin="0,2,0,2"/>

                    <TextBlock Grid.Row="4" Grid.Column="0" x:Name="HintHighlightColorLabelText" Text="Hint Highlight:" VerticalAlignment="Center" Foreground="#1A1A1A"/>
                    <ColorPicker Grid.Row="4" Grid.Column="1" x:Name="HintHighlightColorPicker" ColorChanged="CardColorPicker_ColorChanged" HorizontalAlignment="Right" Margin="0,2,0,2"/>
                </Grid>

                <Button x:Name="ResetCardColorsButton" Content="Reset Card Colors" Click="ResetCardColors_Click" Classes="light-danger" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,2,0,0"/>
            </StackPanel>

        </Grid>

        <!-- ═══════════════════════════════════════════════════════════════════
             OVERLAYS  (cover whichever panel is active)
             ═══════════════════════════════════════════════════════════════════ -->

        <!-- Delete Card Back Confirmation -->
        <Grid x:Name="ConfirmDeleteOverlay" Background="#D0000000" IsVisible="False" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Border Background="White" CornerRadius="8" Padding="15" VerticalAlignment="Center" HorizontalAlignment="Center" BoxShadow="0 4 15 0 #A0000000">
                <StackPanel Spacing="12" Width="230">
                    <TextBlock x:Name="ConfirmDeleteCardBackTitleText" Text="Delete Card Back" FontSize="15" FontWeight="Bold" Foreground="#1A1A1A" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="ConfirmDeleteCardBackBodyText" Text="Are you sure you want to delete this custom card back? This cannot be undone." FontSize="12" Foreground="#1A1A1A" TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center"/>
                    <Grid ColumnDefinitions="*, *" Margin="0,5,0,0">
                        <Button x:Name="CancelDeleteCardBackButton" Content="Cancel" Click="CancelDelete_Click"  Grid.Column="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Classes="light-secondary" Margin="0,0,4,0"/>
                        <Button x:Name="ConfirmDeleteCardBackButton" Content="Delete" Click="ConfirmDelete_Click" Grid.Column="1" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Classes="light-danger" Margin="4,0,0,0"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Card Back In Use (blocks deletion when a saved theme still references it) -->
        <Grid x:Name="CardBackInUseOverlay" Background="#D0000000" IsVisible="False" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Border Background="White" CornerRadius="8" Padding="15" VerticalAlignment="Center" HorizontalAlignment="Center" BoxShadow="0 4 15 0 #A0000000">
                <StackPanel Spacing="12" Width="230">
                    <TextBlock x:Name="CardBackInUseTitleText" Text="Card Back In Use" FontSize="15" FontWeight="Bold" Foreground="#1A1A1A" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="CardBackInUseText" Text="" FontSize="12" Foreground="#1A1A1A" TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center"/>
                    <Button x:Name="CardBackInUseOkButton" Content="OK" Click="CardBackInUseOk_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Classes="light-primary"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Delete Background Confirmation -->
        <Grid x:Name="ConfirmDeleteBackgroundOverlay" Background="#D0000000" IsVisible="False" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Border Background="White" CornerRadius="8" Padding="15" VerticalAlignment="Center" HorizontalAlignment="Center" BoxShadow="0 4 15 0 #A0000000">
                <StackPanel Spacing="12" Width="230">
                    <TextBlock x:Name="ConfirmDeleteBackgroundTitleText" Text="Delete Background" FontSize="15" FontWeight="Bold" Foreground="#1A1A1A" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="ConfirmDeleteBackgroundBodyText" Text="Are you sure you want to delete this custom background? This cannot be undone." FontSize="12" Foreground="#1A1A1A" TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center"/>
                    <Grid ColumnDefinitions="*, *" Margin="0,5,0,0">
                        <Button x:Name="CancelDeleteBackgroundButton" Content="Cancel" Click="CancelDeleteBackground_Click"  Grid.Column="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Classes="light-secondary" Margin="0,0,4,0"/>
                        <Button x:Name="ConfirmDeleteBackgroundButton" Content="Delete" Click="ConfirmDeleteBackground_Click" Grid.Column="1" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Classes="light-danger" Margin="4,0,0,0"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Background Alert (too large / invalid image / in use by a saved theme) -->
        <Grid x:Name="BackgroundAlertOverlay" Background="#D0000000" IsVisible="False" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Border Background="White" CornerRadius="8" Padding="15" VerticalAlignment="Center" HorizontalAlignment="Center" BoxShadow="0 4 15 0 #A0000000">
                <StackPanel Spacing="12" Width="230">
                    <TextBlock x:Name="BackgroundAlertTitleText" Text="Background" FontSize="15" FontWeight="Bold" Foreground="#1A1A1A" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="BackgroundAlertText" Text="" FontSize="12" Foreground="#1A1A1A" TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center"/>
                    <Button x:Name="BackgroundAlertOkButton" Content="OK" Click="BackgroundAlertOk_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Classes="light-primary"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Save Theme Name -->
        <Grid x:Name="SaveThemeOverlay" Background="#D0000000" IsVisible="False" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Border Background="White" CornerRadius="8" Padding="15" VerticalAlignment="Center" HorizontalAlignment="Center" BoxShadow="0 4 15 0 #A0000000">
                <StackPanel Spacing="12" Width="230">
                    <TextBlock x:Name="SaveThemeTitleText" Text="Save New Theme" FontSize="15" FontWeight="Bold" Foreground="#1A1A1A" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="SaveThemePromptText" Text="Enter a name for this theme:" FontSize="12" Foreground="#1A1A1A"/>
                    <TextBox x:Name="ThemeNameInput" Watermark="Theme name…" BorderBrush="#CCCCCC" Foreground="Black"/>
                    <Grid ColumnDefinitions="*, *" Margin="0,5,0,0">
                        <Button x:Name="CancelSaveThemeButton" Content="Cancel" Click="CancelSaveTheme_Click"  Grid.Column="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Classes="light-secondary" Margin="0,0,4,0"/>
                        <Button x:Name="ConfirmSaveThemeButton" Content="Save"   Click="ConfirmSaveTheme_Click" Grid.Column="1" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Classes="light-primary" Margin="4,0,0,0"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Rename Theme -->
        <Grid x:Name="RenameThemeOverlay" Background="#D0000000" IsVisible="False" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Border Background="White" CornerRadius="8" Padding="15" VerticalAlignment="Center" HorizontalAlignment="Center" BoxShadow="0 4 15 0 #A0000000">
                <StackPanel Spacing="12" Width="230">
                    <TextBlock x:Name="RenameThemeTitleText" Text="Rename Theme" FontSize="15" FontWeight="Bold" Foreground="#1A1A1A" HorizontalAlignment="Center"/>
                    <TextBox x:Name="RenameThemeInput" Watermark="Theme name…" BorderBrush="#CCCCCC" Foreground="Black"/>
                    <Grid ColumnDefinitions="*, *" Margin="0,5,0,0">
                        <Button x:Name="CancelRenameThemeButton" Content="Cancel" Click="CancelRenameTheme_Click"  Grid.Column="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Classes="light-secondary" Margin="0,0,4,0"/>
                        <Button x:Name="ConfirmRenameThemeButton" Content="Save"   Click="ConfirmRenameTheme_Click" Grid.Column="1" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Classes="light-primary" Margin="4,0,0,0"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Confirm Delete Theme -->
        <Grid x:Name="ConfirmDeleteThemeOverlay" Background="#D0000000" IsVisible="False" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Border Background="White" CornerRadius="8" Padding="15" VerticalAlignment="Center" HorizontalAlignment="Center" BoxShadow="0 4 15 0 #A0000000">
                <StackPanel Spacing="12" Width="230">
                    <TextBlock x:Name="DeleteThemeTitleText" Text="Delete Theme" FontSize="15" FontWeight="Bold" Foreground="#1A1A1A" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="DeleteThemeConfirmText" Text="Delete this theme?" FontSize="12" Foreground="#1A1A1A" TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center"/>
                    <Grid ColumnDefinitions="*, *" Margin="0,5,0,0">
                        <Button x:Name="CancelDeleteThemeButton" Content="Cancel" Click="CancelDeleteTheme_Click"  Grid.Column="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Classes="light-secondary" Margin="0,0,4,0"/>
                        <Button x:Name="ConfirmDeleteThemeButton" Content="Delete" Click="ConfirmDeleteTheme_Click" Grid.Column="1" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Classes="light-danger" Margin="4,0,0,0"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Confirm Reset Card Colors -->
        <Grid x:Name="ConfirmResetCardColorsOverlay" Background="#D0000000" IsVisible="False" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Border Background="White" CornerRadius="8" Padding="15" VerticalAlignment="Center" HorizontalAlignment="Center" BoxShadow="0 4 15 0 #A0000000">
                <StackPanel Spacing="12" Width="230">
                    <TextBlock x:Name="ConfirmResetCardColorsTitleText" Text="Reset Card Colors" FontSize="15" FontWeight="Bold" Foreground="#1A1A1A" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="ConfirmResetCardColorsBodyText" Text="Are you sure you want to reset the card colors to default?" FontSize="12" Foreground="#1A1A1A" TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center"/>
                    <Grid ColumnDefinitions="*, *" Margin="0,5,0,0">
                        <Button x:Name="CancelResetCardColorsButton" Content="Cancel" Click="CancelResetCardColors_Click"  Grid.Column="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Classes="light-secondary" Margin="0,0,4,0"/>
                        <Button x:Name="ConfirmResetCardColorsButton" Content="Reset" Click="ConfirmResetCardColors_Click" Grid.Column="1" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Classes="light-danger" Margin="4,0,0,0"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>


    </Grid>
</UserControl>
