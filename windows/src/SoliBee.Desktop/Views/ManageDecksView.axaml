<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SoliBee.Desktop.Views"
             x:Class="SoliBee.Desktop.Views.ManageDecksView"
             MinHeight="500" MinWidth="400">

    <!-- Deck-row and Start Over buttons use the app-wide Button.light-primary/
         light-secondary/light-danger classes (App.axaml) — the same ones Rules
         (HoneycombRulesView) and Options (MainWindow's Preferences panel) use,
         instead of locally-defined btn-blue/btn-red/btn-gray styles that drifted
         out of sync with the rest of the app's dialog buttons. -->
    <UserControl.Styles>
        <Style Selector="ToggleButton.heart-btn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="2"/>
        </Style>
        <Style Selector="ToggleButton.heart-btn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="ToggleButton.heart-btn:checked /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="ComboBox">
            <Setter Property="Background" Value="#F2F2F2"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="8,4"/>
        </Style>

        <!-- Without this, the default Fluent ToggleButton theme paints its own
             accent-blue background on :checked, turning a checked Favorites
             filter into a bold solid-blue button instead of the neutral pill
             used everywhere else (see DeckBuilderView.axaml for the same fix). -->
        <Style Selector="ToggleButton#FavoritesFilter:checked /template/ ContentPresenter">
            <Setter Property="Background" Value="#FFE3E3"/>
        </Style>

        <!-- Freeform stat-search boxes: single-character slots, so narrower/shorter
             than a normal text field, with a bottom underline (not a flat fill alone)
             so they read as "type here" inputs rather than decorative gray blocks.
             MinWidth/MinHeight are set explicitly (not just Width/Height) because the
             Fluent theme's default TextBox MinWidth (~120px) otherwise wins over
             Width, rendering these as full-size search-bar-looking boxes instead of
             small stat slots — that's also what made Left/Right's oversized,
             overlapping boxes visually merge into what looked like one bar instead
             of two. -->
        <Style Selector="TextBox.stat-search">
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="MinWidth" Value="22"/>
            <Setter Property="MinHeight" Value="22"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="#F2F2F2"/>
            <Setter Property="BorderBrush" Value="#B0B0B0"/>
            <Setter Property="BorderThickness" Value="0,0,0,1.5"/>
            <Setter Property="CornerRadius" Value="2"/>
            <Setter Property="MaxLength" Value="1"/>
        </Style>
    </UserControl.Styles>

    <!-- Outer grid: content + overlay -->
    <Grid>

        <!-- Main Two-Column Layout — Saved Decks only ever needs to fit 5 small card
             thumbnails + two buttons (~320px), so a 50/50 split (mac equivalent:
             leftWidth = max(300, width * 0.32), see HoneycombDecksView.swift) left
             Card Bank's card grid squeezed into the same width as that mostly-empty
             column. Fixed-width left column, Card Bank takes the rest. -->
        <Grid ColumnDefinitions="320, *" Margin="16">

            <!-- LEFT: Freeform stat search, then Saved Decks -->
            <Grid Grid.Column="0" RowDefinitions="Auto, Auto, Auto, *, Auto" Margin="0,0,10,0">

                <!-- Freeform stat search — a single control instead of separate
                     side/direction dropdowns: type a value onto the mini card at the
                     position it actually appears on a real card, and the grid filters
                     live. Leaving a box empty means "don't filter on that side". -->
                <TextBlock x:Name="StatSearchHintText" Grid.Row="0" Text="Freeform search: type a value onto the card to filter the bank."
                           FontSize="12" Foreground="#1A1A1A" TextWrapping="Wrap" Margin="0,0,0,10"/>

                <Border Grid.Row="1" Width="96" Height="128" HorizontalAlignment="Center"
                        Background="White" BorderBrush="#000000" BorderThickness="2"
                        CornerRadius="6" Margin="0,0,0,16" BoxShadow="0 3 8 0 #33000000">
                    <Grid>
                        <!-- Dummy suit — a club glyph at low opacity, matching mac's
                             identical Image(systemName: "suit.club.fill").foregroundColor
                             (.gray).opacity(0.3) treatment exactly. It's still
                             unambiguously "a club", not a real card in the bank, purely
                             because of the faded opacity here. -->
                        <TextBlock Text="♣" FontSize="34" Foreground="Gray" Opacity="0.3"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <TextBox x:Name="StatSearchTop" Classes="stat-search"
                                 HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,6,0,0"
                                 TextChanged="StatSearch_TextChanged"/>
                        <TextBox x:Name="StatSearchLeft" Classes="stat-search"
                                 HorizontalAlignment="Left" VerticalAlignment="Center" Margin="6,0,0,0"
                                 TextChanged="StatSearch_TextChanged"/>
                        <TextBox x:Name="StatSearchRight" Classes="stat-search"
                                 HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0"
                                 TextChanged="StatSearch_TextChanged"/>
                        <TextBox x:Name="StatSearchBottom" Classes="stat-search"
                                 HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,6"
                                 TextChanged="StatSearch_TextChanged"/>
                    </Grid>
                </Border>

                <TextBlock Grid.Row="2" Text="SAVED DECKS"
                           FontSize="12" FontWeight="Bold" Foreground="#888"
                           Margin="0,0,0,12"/>

                <ScrollViewer Grid.Row="3">
                    <StackPanel x:Name="DecksListPanel" Spacing="10"/>
                </ScrollViewer>

                <!-- Start Over -->
                <Border Grid.Row="4" Background="#C0392B" CornerRadius="10"
                        Padding="16,12" Margin="0,16,0,0">
                    <StackPanel Spacing="10">
                        <TextBlock x:Name="StartOverBodyText" Text="Start over clears your decks and card bank, then reseeds the game."
                                   FontSize="12" Foreground="White" TextWrapping="Wrap"/>
                        <Button x:Name="StartOverButton" Content="Start Over" Classes="light-warning"
                                HorizontalAlignment="Left" Click="StartOver_Click"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Divider -->
            <Rectangle Grid.Column="0" Width="1" Fill="#E0E0E0"
                       HorizontalAlignment="Right" VerticalAlignment="Stretch" Margin="0,0,0,0"/>

            <!-- RIGHT: Card Bank -->
            <Grid Grid.Column="1" RowDefinitions="Auto, Auto, *" Margin="10,0,0,0">

                <!-- Constrained watermark (matches Stats/Rules/Options) — spans the whole
                     column so it stays fixed behind the title/filters/card grid rather than
                     living inside BankScrollViewer's scrollable content, where it would
                     scroll away with the cards instead of sitting underneath them. -->
                <Image Source="avares://Honeycomb/Assets/solibee.png" Opacity="0.15" Stretch="Uniform"
                       MaxWidth="550" MaxHeight="550" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Grid.Row="0" Grid.RowSpan="3" IsHitTestVisible="False"
                       IsVisible="{Binding !HideBee}" />

                <TextBlock x:Name="CardBankTitle" Grid.Row="0"
                           Text="CARD BANK" FontSize="12" FontWeight="Bold"
                           Foreground="#888" Margin="0,0,0,10"/>

                <!-- Filters — all three given the same explicit Height, since ComboBox's
                     template carries extra internal chrome (the dropdown-arrow area) that
                     makes it render taller than a plain ToggleButton with matching
                     Padding, even though neither control has an explicit Height of its
                     own to compare against. -->
                <WrapPanel Grid.Row="1" Margin="0,0,0,10">
                    <ComboBox x:Name="StarsFilter" Width="105" Height="36" Margin="0,0,6,6"
                              SelectionChanged="FilterCombo_SelectionChanged" SelectedIndex="0">
                        <ComboBoxItem x:Name="AllStarsItem" Content="All Stars"/>
                        <ComboBoxItem x:Name="OneStarItem" Content="1 Star"/>
                        <ComboBoxItem x:Name="TwoStarsItem" Content="2 Stars"/>
                        <ComboBoxItem x:Name="ThreeStarsItem" Content="3 Stars"/>
                        <ComboBoxItem x:Name="FourStarsItem" Content="4 Stars"/>
                        <ComboBoxItem x:Name="FiveStarsItem" Content="5 Stars"/>
                    </ComboBox>
                    <ComboBox x:Name="SuitsFilter" Width="105" Height="36" Margin="0,0,6,6"
                              SelectionChanged="FilterCombo_SelectionChanged" SelectedIndex="0">
                        <ComboBoxItem x:Name="AllSuitsItem" Content="All Suits"/>
                        <ComboBoxItem x:Name="SpadesItem" Content="Spades"/>
                        <ComboBoxItem x:Name="HeartsItem" Content="Hearts"/>
                        <ComboBoxItem x:Name="DiamondsItem" Content="Diamonds"/>
                        <ComboBoxItem x:Name="ClubsItem" Content="Clubs"/>
                    </ComboBox>
                    <ToggleButton x:Name="FavoritesFilter" Content="♡ Favorites" Height="36"
                                  VerticalContentAlignment="Center"
                                  CornerRadius="8" Background="#F0F0F0" Padding="8,4"
                                  Margin="0,0,0,6"
                                  Checked="FilterToggle_CheckedChanged"
                                  Unchecked="FilterToggle_CheckedChanged"/>
                </WrapPanel>

                <ScrollViewer Grid.Row="2" x:Name="BankScrollViewer" ScrollChanged="BankScrollViewer_ScrollChanged">
                    <Grid>
                        <!-- Mac's Card Bank grid is flat (no shadow/background box per
                             cell) with generously spaced, larger cards doing the visual
                             separation on their own — matching that here instead of the
                             smaller shadowed tiles from the earlier pass. -->
                        <!-- Sized so 5 columns fit at the dialog's fixed 1000px width
                             instead of 4 — see BuildBankCell for the matching card
                             content size (96x135, same aspect ratio as the old 112x157). -->
                        <WrapPanel x:Name="BankPanel" ItemWidth="110" ItemHeight="150"/>

                        <TextBlock x:Name="EmptyFilterMessage" Text="No cards match this filter."
                                   FontSize="14" Foreground="#999"
                                   HorizontalAlignment="Left" VerticalAlignment="Top"
                                   Margin="0,24,0,0" IsVisible="False"/>
                    </Grid>
                </ScrollViewer>
            </Grid>

        </Grid>

        <!-- Start Over Confirmation Overlay -->
        <Grid x:Name="StartOverOverlay" Background="#99000000" IsVisible="False" ZIndex="200">
            <Border Background="White" CornerRadius="12" Padding="28,24"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    MaxWidth="380" BoxShadow="0 6 24 0 #88000000">
                <StackPanel Spacing="16">
                    <TextBlock x:Name="StartOverOverlayTitleText" Text="Start Over?" FontSize="20" FontWeight="Bold"
                               HorizontalAlignment="Center" Foreground="#1A1A1A"/>
                    <TextBlock x:Name="StartOverOverlayBodyText" Text="This will clear all saved decks and your card bank, then reseed the game with brand new cards. This cannot be undone."
                               FontSize="13" Foreground="#555" TextWrapping="Wrap"
                               HorizontalAlignment="Center" TextAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" Spacing="16" HorizontalAlignment="Center" Margin="0,8,0,0">
                        <Button x:Name="CancelStartOverButton" Content="Cancel" Classes="light-secondary" Click="CancelStartOver_Click"/>
                        <Button x:Name="ConfirmStartOverButton" Content="Yes, Start Over" Classes="light-danger" Click="ConfirmStartOver_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

    </Grid>
</UserControl>
