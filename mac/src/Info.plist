<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleExecutable</key>
    <string>Honeycomb</string>
    <key>CFBundleIdentifier</key>
    <string>com.leah.SoliBee</string>
    <key>CFBundleName</key>
    <string>Honeycomb Card Suite</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <!-- Overridden at release-build time by build-release-mac.yml (via PlistBuddy),
         which derives the real value from the git tag (e.g. v7.0.4) so the About
         window's version always matches what actually shipped — never bump these by
         hand for a release, only the tag matters. This baseline is only what a local
         (non-CI) `make build` shows. -->
    <key>CFBundleShortVersionString</key>
    <string>7.0.4</string>
    <key>CFBundleVersion</key>
    <string>7.0.4</string>
    <key>LSMinimumSystemVersion</key>
    <string>14.0</string>
    <key>NSPrincipalClass</key>
    <string>NSApplication</string>
    <key>CFBundleIconFile</key>
    <string>AppIcon</string>
    <key>NSHumanReadableCopyright</key>
    <string>© 2026 Leahbee. All rights reserved.</string>
</dict>
</plist>
