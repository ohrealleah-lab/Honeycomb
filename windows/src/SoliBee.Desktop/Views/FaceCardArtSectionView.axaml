<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SoliBee.Desktop.Views.FaceCardArtSectionView">
  <Grid>
    <!-- Each suit is a column (A/J/Q/K stacked vertically), 4 suit-columns laid out
         side by side. The outer StackPanel hugs its content width instead of a
         UniformGrid, which would stretch the 4 columns to fill FaceCardsPanel's full
         770px width and leave large gaps between them — a fixed Spacing keeps the
         columns close together, centered as a group. UniformGrid per column stacks
         its 4 tiles (same tile size, avoids the "forces a vertical scrollbar"
         tradeoff noted in BuildTile's own comment). -->
    <StackPanel Orientation="Horizontal" Spacing="24" HorizontalAlignment="Center">
      <UniformGrid x:Name="SpadesRow" Columns="1" />
      <UniformGrid x:Name="HeartsRow" Columns="1" />
      <UniformGrid x:Name="DiamondsRow" Columns="1" />
      <UniformGrid x:Name="ClubsRow" Columns="1" />
    </StackPanel>

    <!-- Confirm delete overlay -->
    <Grid x:Name="ConfirmDeleteOverlay" Background="#D0000000" IsVisible="False"
          HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
      <Border Background="White" CornerRadius="8" Padding="15"
              VerticalAlignment="Center" HorizontalAlignment="Center"
              BoxShadow="0 4 15 0 #A0000000">
        <StackPanel Spacing="12" Width="210">
          <TextBlock Text="Remove Face Card Art" FontSize="14" FontWeight="Bold"
                     Foreground="#1A1A1A" HorizontalAlignment="Center" />
          <TextBlock Text="Remove the custom art for this slot? This cannot be undone."
                     FontSize="11" Foreground="#1A1A1A" TextWrapping="Wrap"
                     HorizontalAlignment="Center" TextAlignment="Center" />
          <Grid ColumnDefinitions="*, *" Margin="0,4,0,0">
            <Button Content="Cancel" Click="CancelDelete_Click" Grid.Column="0"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                    Classes="light-secondary" Margin="0,0,4,0" />
            <Button Content="Remove" Click="ConfirmDelete_Click" Grid.Column="1"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                    Classes="light-danger" Margin="4,0,0,0" />
          </Grid>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</UserControl>
