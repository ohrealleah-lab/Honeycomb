<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SoliBee.Desktop.Views.BeekeeperView">

    <UserControl.Styles>
        <!-- Glass card: dark translucent panel, soft border, 12px corners (UI_SPEC §3) -->
        <Style Selector="Border.bk-card">
            <Setter Property="Background" Value="#8C0C0803" />
            <Setter Property="BorderBrush" Value="#1AFFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="16" />
        </Style>
        <Style Selector="TextBlock.bk-title">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Opacity" Value="0.6" />
        </Style>
        <Style Selector="TextBlock.bk-body">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="TextBlock.bk-muted">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Opacity" Value="0.65" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="Button.bk-button">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#26FFFFFF" />
            <Setter Property="BorderBrush" Value="#33FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Button.bk-button:disabled /template/ ContentPresenter">
            <Setter Property="Opacity" Value="0.4" />
        </Style>
        <!-- Catch Bee always stays highlighted (Leah): no grey hover or pressed look. -->
        <Style Selector="Button#CatchButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{Binding $parent[Button].Background}" />
            <Setter Property="Foreground" Value="{Binding $parent[Button].Foreground}" />
        </Style>
        <Style Selector="Button#CatchButton:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{Binding $parent[Button].Background}" />
            <Setter Property="Foreground" Value="{Binding $parent[Button].Foreground}" />
        </Style>
    </UserControl.Styles>

    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
        <Grid Margin="20,12,20,20" MinWidth="980" ColumnDefinitions="340,*,260" ColumnSpacing="16">

            <!-- ───────── LEFT: art, Catch Bee, Hive, Smoker ───────── -->
            <StackPanel Grid.Column="0" Spacing="12">
                <!-- Pixel-art slot (170x102 shown at 2x). Art arrives later; until then a quiet placeholder. -->
                <Border Classes="bk-card" Height="204" Padding="0" ClipToBounds="True">
                    <Grid>
                        <TextBlock Text="🐝" FontSize="56" Opacity="0.35" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Image x:Name="ArtImage" Stretch="Uniform" RenderOptions.BitmapInterpolationMode="None" />
                    </Grid>
                </Border>

                <!-- Catch Bee + its popup layer -->
                <Grid>
                    <Button x:Name="CatchButton" Height="64" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center" CornerRadius="14" FontFamily="Segoe UI" FontSize="20"
                            FontWeight="Bold" Foreground="#2B1D05" Background="#FFD300" Click="Catch_Click">
                        <Button.RenderTransform>
                            <TranslateTransform />
                        </Button.RenderTransform>
                    </Button>
                    <TextBlock x:Name="CatchPopup" IsHitTestVisible="False" Opacity="0" HorizontalAlignment="Center"
                               VerticalAlignment="Top" Margin="0,-6,0,0" FontFamily="Georgia" FontSize="18"
                               FontWeight="Bold" Foreground="White">
                        <TextBlock.RenderTransform>
                            <TranslateTransform />
                        </TextBlock.RenderTransform>
                    </TextBlock>
                </Grid>
                <!-- THE HIVE (appears with the first bee) -->
                <Border x:Name="HiveCard" Classes="bk-card" IsVisible="False">
                    <StackPanel Spacing="6">
                        <TextBlock x:Name="HiveTitleText" Classes="bk-title" />
                        <!-- What the hive holds. Later materials (sage, candles…) get rows here too. -->
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="2">
                            <TextBlock x:Name="HiveBeesLabel" Classes="bk-body" Opacity="0.75" />
                            <TextBlock x:Name="HiveBeesValue" Grid.Column="1" Classes="bk-body" FontWeight="SemiBold" />
                            <TextBlock x:Name="HiveHoneyLabel" Grid.Row="1" Classes="bk-body" Opacity="0.75" />
                            <TextBlock x:Name="HiveHoneyValue" Grid.Row="1" Grid.Column="1" Classes="bk-body" FontWeight="SemiBold" />
                            <TextBlock x:Name="HiveWaxLabel" Grid.Row="2" Classes="bk-body" Opacity="0.75" />
                            <TextBlock x:Name="HiveWaxValue" Grid.Row="2" Grid.Column="1" Classes="bk-body" FontWeight="SemiBold" />
                            <TextBlock x:Name="HiveCombsLabel" Grid.Row="3" Classes="bk-body" Opacity="0.75" />
                            <TextBlock x:Name="HiveCombsValue" Grid.Row="3" Grid.Column="1" Classes="bk-body" FontWeight="SemiBold" />
                            <TextBlock x:Name="HiveBeebitsLabel" Grid.Row="4" Classes="bk-body" Opacity="0.75" />
                            <TextBlock x:Name="HiveBeebitsValue" Grid.Row="4" Grid.Column="1" Classes="bk-body" FontWeight="SemiBold" />
                            <TextBlock x:Name="HiveBeeswaxLabel" Grid.Row="5" Classes="bk-body" Opacity="0.75" />
                            <TextBlock x:Name="HiveBeeswaxValue" Grid.Row="5" Grid.Column="1" Classes="bk-body" FontWeight="SemiBold" />
                            <TextBlock x:Name="HiveRepellentLabel" Grid.Row="6" Classes="bk-body" Opacity="0.75" />
                            <TextBlock x:Name="HiveRepellentValue" Grid.Row="6" Grid.Column="1" Classes="bk-body" FontWeight="SemiBold" />
                            <TextBlock x:Name="HiveSageLabel" Grid.Row="7" Classes="bk-body" Opacity="0.75" />
                            <TextBlock x:Name="HiveSageValue" Grid.Row="7" Grid.Column="1" Classes="bk-body" FontWeight="SemiBold" />
                            <TextBlock x:Name="HiveSeedsLabel" Grid.Row="8" Classes="bk-body" Opacity="0.75" />
                            <TextBlock x:Name="HiveSeedsValue" Grid.Row="8" Grid.Column="1" Classes="bk-body" FontWeight="SemiBold" />
                            <TextBlock x:Name="HiveForagersLabel" Grid.Row="9" Classes="bk-body" Opacity="0.75" />
                            <TextBlock x:Name="HiveForagersValue" Grid.Row="9" Grid.Column="1" Classes="bk-body" FontWeight="SemiBold" />
                            <TextBlock x:Name="HiveGuardsLabel" Grid.Row="10" Classes="bk-body" Opacity="0.75" />
                            <TextBlock x:Name="HiveGuardsValue" Grid.Row="10" Grid.Column="1" Classes="bk-body" FontWeight="SemiBold" />
                            <TextBlock x:Name="HivePollenLabel" Grid.Row="11" Classes="bk-body" Opacity="0.75" />
                            <TextBlock x:Name="HivePollenValue" Grid.Row="11" Grid.Column="1" Classes="bk-body" FontWeight="SemiBold" />
                            <TextBlock x:Name="HiveBeeBreadLabel" Grid.Row="12" Classes="bk-body" Opacity="0.75" />
                            <TextBlock x:Name="HiveBeeBreadValue" Grid.Row="12" Grid.Column="1" Classes="bk-body" FontWeight="SemiBold" />
                        </Grid>
                        <TextBlock x:Name="HoneyRateText" Classes="bk-body" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock x:Name="WaxRateText" Classes="bk-body" FontSize="18" FontWeight="SemiBold" IsVisible="False" />
                        <TextBlock x:Name="HiveFullText" Classes="bk-body" Foreground="#FFA38F" IsVisible="False" />
                        <!-- Offered once the first bee bread is made: move to a wooden hive -->
                        <Grid x:Name="WoodenHiveRow" ColumnDefinitions="*,Auto" IsVisible="False" Margin="0,6,0,0">
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock x:Name="WoodenHiveNameText" Classes="bk-body" FontWeight="SemiBold" />
                                <TextBlock x:Name="WoodenHiveInfoText" Classes="bk-muted" />
                            </StackPanel>
                            <Button x:Name="MoveHiveButton" Grid.Column="1" Classes="bk-button" MinWidth="90"
                                    HorizontalContentAlignment="Center" VerticalAlignment="Center" Click="MoveHive_Click" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- THE SMOKER (once bought): clicks fill the calm meter; a puff calms the bees -->
                <Border x:Name="SmokerCard" Classes="bk-card" IsVisible="False">
                    <StackPanel Spacing="6">
                        <TextBlock x:Name="SmokerTitleText" Classes="bk-title" />
                        <TextBlock x:Name="SmokerStatusText" Classes="bk-muted" />
                        <ProgressBar x:Name="CalmBar" Minimum="0" Maximum="1" Height="8" Foreground="#FFD300" Background="#33FFFFFF" />
                        <Button x:Name="PuffButton" Classes="bk-button" HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center" Click="Puff_Click" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ───────── CENTRE: Bear, Shop, Combs ───────── -->
            <StackPanel Grid.Column="1" Spacing="12">
                <!-- TRADING: every buyer (the Bear, the Hippies, later others) as one row each -->
                <Border x:Name="TradeCard" Classes="bk-card" IsVisible="False">
                    <StackPanel Spacing="10">
                        <TextBlock x:Name="TradeTitleText" Classes="bk-title" />
                        <StackPanel x:Name="TradeRows" Spacing="14" />
                    </StackPanel>
                </Border>

                <Border x:Name="ShopCard" Classes="bk-card" IsVisible="False">
                    <StackPanel Spacing="10">
                        <TextBlock x:Name="ShopTitleText" Classes="bk-title" />
                        <StackPanel x:Name="ShopRows" Spacing="8" />
                    </StackPanel>
                </Border>

                <!-- THE WORKBENCH: building combs (from the first 50 wax), then candles (from the
                     2nd comb). Upgrades are in the Shop. -->
                <Border x:Name="WorkbenchCard" Classes="bk-card" IsVisible="False">
                    <StackPanel Spacing="10">
                        <TextBlock x:Name="WorkbenchTitleText" Classes="bk-title" />
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock x:Name="CombNameText" Classes="bk-body" FontWeight="SemiBold" />
                                <TextBlock x:Name="CombsInfoText" Classes="bk-muted" />
                            </StackPanel>
                            <Button x:Name="BuildCombButton" Grid.Column="1" Classes="bk-button" MinWidth="90"
                                    HorizontalContentAlignment="Center" VerticalAlignment="Center" Click="BuildComb_Click" />
                        </Grid>
                        <Grid x:Name="BeeswaxRow" ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock x:Name="BeeswaxNameText" Classes="bk-body" FontWeight="SemiBold" />
                                <TextBlock x:Name="BeeswaxInfoText" Classes="bk-muted" />
                            </StackPanel>
                            <Button x:Name="CraftBeeswaxButton" Grid.Column="1" Classes="bk-button" MinWidth="90"
                                    HorizontalContentAlignment="Center" VerticalAlignment="Center" Click="CraftBeeswax_Click" />
                        </Grid>
                        <Grid x:Name="BeeBreadRow" ColumnDefinitions="*,Auto" IsVisible="False">
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock x:Name="BeeBreadNameText" Classes="bk-body" FontWeight="SemiBold" />
                                <TextBlock x:Name="BeeBreadInfoText" Classes="bk-muted" />
                            </StackPanel>
                            <Button x:Name="MakeBeeBreadButton" Grid.Column="1" Classes="bk-button" MinWidth="90"
                                    HorizontalContentAlignment="Center" VerticalAlignment="Center" Click="MakeBeeBread_Click" />
                        </Grid>
                        <Grid x:Name="RepellentRow" ColumnDefinitions="*,Auto" IsVisible="False">
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock x:Name="RepellentNameText" Classes="bk-body" FontWeight="SemiBold" />
                                <TextBlock x:Name="RepellentInfoText" Classes="bk-muted" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <Button x:Name="CraftRepellentButton" Classes="bk-button" MinWidth="90"
                                        HorizontalContentAlignment="Center" Click="CraftRepellent_Click" />
                                <Button x:Name="LightRepellentButton" Classes="bk-button" MinWidth="90"
                                        HorizontalContentAlignment="Center" Click="LightRepellent_Click" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- THE GARDEN (from the first seed): plant, wait, sprout -->
                <Border x:Name="GardenCard" Classes="bk-card" IsVisible="False">
                    <StackPanel Spacing="10">
                        <TextBlock x:Name="GardenTitleText" Classes="bk-title" />
                        <TextBlock x:Name="GardenStatusText" Classes="bk-body" FontWeight="SemiBold" />
                        <Button x:Name="PlantSeedButton" Classes="bk-button" HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center" Click="PlantSeed_Click" />
                        <StackPanel x:Name="PlantRows" Spacing="8" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ───────── RIGHT: wasps, story log ───────── -->
            <StackPanel Grid.Column="2" Spacing="12" VerticalAlignment="Top">
                <!-- Shown while a wasp is here or a repellent candle burns -->
                <Border x:Name="WaspCard" Classes="bk-card" IsVisible="False" BorderBrush="#66FFA38F">
                    <StackPanel Spacing="8">
                        <TextBlock x:Name="WaspTitleText" Classes="bk-title" />
                        <StackPanel x:Name="WaspHerePanel" Spacing="8">
                            <TextBlock x:Name="WaspHereText" Classes="bk-body" FontWeight="SemiBold" />
                            <TextBlock x:Name="WaspTimeText" Classes="bk-muted" />
                            <Button x:Name="ThrowShoeButton" Classes="bk-button" HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center" Click="ThrowShoe_Click" />
                            <Button x:Name="BribeButton" Classes="bk-button" HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center" Click="Bribe_Click" />
                            <Button x:Name="WaspLightButton" Classes="bk-button" HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center" Click="LightRepellent_Click" />
                        </StackPanel>
                        <TextBlock x:Name="CandleBurningText" Classes="bk-body" IsVisible="False" />
                    </StackPanel>
                </Border>

                <!-- BEES: each kind met so far, what it does and a bee fact -->
                <Border x:Name="BeesCard" Classes="bk-card" IsVisible="False">
                    <StackPanel Spacing="10">
                        <TextBlock x:Name="BeesTitleText" Classes="bk-title" />
                        <StackPanel x:Name="BeeRows" Spacing="12" />
                    </StackPanel>
                </Border>

                <Border Classes="bk-card">
                    <StackPanel Spacing="10">
                        <TextBlock x:Name="LogTitleText" Classes="bk-title" />
                        <StackPanel x:Name="LogLines" Spacing="8" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
