<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SoliBee.Desktop.Views.BeekeeperView">

    <UserControl.Styles>
        <!-- Glass card: dark translucent panel, soft border, 12px corners (UI_SPEC §3) -->
        <Style Selector="Border.bk-card">
            <Setter Property="Background" Value="#8C0C0803" />
            <Setter Property="BorderBrush" Value="#1AFFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="16" />
        </Style>
        <Style Selector="TextBlock.bk-title">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Opacity" Value="0.6" />
        </Style>
        <Style Selector="TextBlock.bk-body">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="TextBlock.bk-muted">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Opacity" Value="0.65" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="Button.bk-button">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#26FFFFFF" />
            <Setter Property="BorderBrush" Value="#33FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <!-- Disabled buttons fade their box but keep the text (the cost) easy to read. -->
        <Style Selector="Button.bk-button:disabled">
            <Setter Property="Foreground" Value="#CCFFFFFF" />
        </Style>
        <Style Selector="Button.bk-button:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#14FFFFFF" />
            <Setter Property="BorderBrush" Value="#1AFFFFFF" />
            <Setter Property="Foreground" Value="#CCFFFFFF" />
        </Style>
        <!-- Hovering or pressing keeps the glass look: a touch lighter, never dark. -->
        <Style Selector="Button.bk-button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#33FFFFFF" />
            <Setter Property="BorderBrush" Value="#4DFFFFFF" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Button.bk-button:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#40FFFFFF" />
            <Setter Property="BorderBrush" Value="#4DFFFFFF" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Button.bk-button:disabled:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#14FFFFFF" />
            <Setter Property="BorderBrush" Value="#1AFFFFFF" />
            <Setter Property="Foreground" Value="#CCFFFFFF" />
        </Style>
        <!-- Catch Bee always stays highlighted (Leah): no grey hover or pressed look. -->
        <Style Selector="Button#CatchButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{Binding $parent[Button].Background}" />
            <Setter Property="Foreground" Value="{Binding $parent[Button].Foreground}" />
        </Style>
        <Style Selector="Button#CatchButton:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{Binding $parent[Button].Background}" />
            <Setter Property="Foreground" Value="{Binding $parent[Button].Foreground}" />
        </Style>
    </UserControl.Styles>

    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
        <Grid Margin="20,12,20,20" MinWidth="980" ColumnDefinitions="340,*,260" ColumnSpacing="16">

            <!-- ───────── LEFT: art, Catch Bee, Hive, Smoker, Notebook ───────── -->
            <StackPanel Grid.Column="0" Spacing="12">
                <!-- Pixel-art slot (170x102 shown at 2x). Art arrives later; until then a quiet placeholder. -->
                <Border Classes="bk-card" Height="204" Padding="0" ClipToBounds="True">
                    <Grid>
                        <TextBlock Text="🐝" FontSize="56" Opacity="0.35" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Image x:Name="ArtImage" Stretch="Uniform" RenderOptions.BitmapInterpolationMode="None" />
                    </Grid>
                </Border>

                <!-- Catch Bee + its popup layer -->
                <Grid>
                    <Button x:Name="CatchButton" Height="64" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center" CornerRadius="14" FontFamily="Segoe UI" FontSize="20"
                            FontWeight="Bold" Foreground="#2B1D05" Background="#FFD300" Click="Catch_Click">
                        <Button.RenderTransform>
                            <TranslateTransform />
                        </Button.RenderTransform>
                    </Button>
                    <TextBlock x:Name="CatchPopup" IsHitTestVisible="False" Opacity="0" HorizontalAlignment="Center"
                               VerticalAlignment="Top" Margin="0,-6,0,0" FontFamily="Georgia" FontSize="18"
                               FontWeight="Bold" Foreground="White">
                        <TextBlock.RenderTransform>
                            <TranslateTransform />
                        </TextBlock.RenderTransform>
                    </TextBlock>
                </Grid>
                <!-- THE HIVE (appears with the first bee, or since stage 7.5 the first whole wax) -->
                <Border x:Name="HiveCard" Classes="bk-card" IsVisible="False">
                    <StackPanel Spacing="6">
                        <TextBlock x:Name="HiveTitleText" Classes="bk-title" />
                        <!-- What the hive holds, in groups (Bees, The hive, Garden, Crafts, Trade goods).
                             Built in code from the view model's HiveGroups (spec 014, FR-505): a new
                             row is a new entry there, not a new line here. -->
                        <StackPanel x:Name="HiveGroups" Spacing="10" />
                        <!-- Offered once the first bee bread is made: move to a wooden hive -->
                        <Grid x:Name="WoodenHiveRow" ColumnDefinitions="*,Auto" IsVisible="False" Margin="0,6,0,0">
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock x:Name="WoodenHiveNameText" Classes="bk-body" FontWeight="SemiBold" />
                                <TextBlock x:Name="WoodenHiveInfoText" Classes="bk-muted" />
                                <!-- Stage 7.5: "Needs more wax storage" when the price is above the cap -->
                                <TextBlock x:Name="WoodenHiveWallText" Classes="bk-muted" IsVisible="False" />
                            </StackPanel>
                            <Button x:Name="MoveHiveButton" Grid.Column="1" Classes="bk-button" MinWidth="90"
                                    HorizontalContentAlignment="Center" VerticalAlignment="Center" Click="MoveHive_Click" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- THE SMOKER (once bought): clicks fill the calm meter; a puff calms the bees -->
                <Border x:Name="SmokerCard" Classes="bk-card" IsVisible="False">
                    <StackPanel Spacing="6">
                        <TextBlock x:Name="SmokerTitleText" Classes="bk-title" />
                        <TextBlock x:Name="SmokerStatusText" Classes="bk-muted" />
                        <ProgressBar x:Name="CalmBar" Minimum="0" Maximum="1" Height="8" Foreground="#FFD300" Background="#33FFFFFF" />
                        <Button x:Name="PuffButton" Classes="bk-button" HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center" Click="Puff_Click" />
                    </StackPanel>
                </Border>

                <!-- THE BEEKEEPER'S NOTEBOOK (stage 7): the Bees card, back as a Shop upgrade. One note per thing the hive has. -->
                <Border x:Name="NotebookCard" Classes="bk-card" IsVisible="False">
                    <StackPanel Spacing="8">
                        <TextBlock x:Name="NotebookTitleText" Classes="bk-title" />
                        <StackPanel x:Name="NotebookRows" Spacing="8" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ───────── CENTRE: Trading, Shop, Workbench, Garden ───────── -->
            <StackPanel Grid.Column="1" Spacing="12">
                <!-- TRADING: every buyer (the Bear, the Hippies, later others) as one row each -->
                <Border x:Name="TradeCard" Classes="bk-card" IsVisible="False">
                    <StackPanel Spacing="10">
                        <TextBlock x:Name="TradeTitleText" Classes="bk-title" />
                        <StackPanel x:Name="TradeRows" Spacing="14" />
                    </StackPanel>
                </Border>

                <Border x:Name="ShopCard" Classes="bk-card" IsVisible="False">
                    <StackPanel Spacing="10">
                        <TextBlock x:Name="ShopTitleText" Classes="bk-title" />
                        <StackPanel x:Name="ShopRows" Spacing="8" />
                    </StackPanel>
                </Border>

                <!-- THE WORKBENCH: building combs (from the first 5 wax), Honey Supers and Wax Trays
                     (stage 7.5, once the Shop is open), then candles (from the 3rd comb, the starter
                     counted). Upgrades are in the Shop. -->
                <Border x:Name="WorkbenchCard" Classes="bk-card" IsVisible="False">
                    <StackPanel Spacing="10">
                        <TextBlock x:Name="WorkbenchTitleText" Classes="bk-title" />
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock x:Name="CombNameText" Classes="bk-body" FontWeight="SemiBold" />
                                <TextBlock x:Name="CombsInfoText" Classes="bk-muted" />
                                <!-- Stage 7.5: "Needs more wax storage" when the price is above the cap -->
                                <TextBlock x:Name="CombWallText" Classes="bk-muted" IsVisible="False" />
                            </StackPanel>
                            <Button x:Name="BuildCombButton" Grid.Column="1" Classes="bk-button" MinWidth="90"
                                    HorizontalContentAlignment="Center" VerticalAlignment="Center" Click="BuildComb_Click" />
                        </Grid>
                        <!-- Stage 7.5 (spec 016): capacity upgrades, bought again and again for Beebits -->
                        <Grid x:Name="HoneySuperRow" ColumnDefinitions="*,Auto" IsVisible="False">
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock x:Name="HoneySuperNameText" Classes="bk-body" FontWeight="SemiBold" />
                                <TextBlock x:Name="HoneySuperInfoText" Classes="bk-muted" />
                            </StackPanel>
                            <Button x:Name="BuyHoneySuperButton" Grid.Column="1" Classes="bk-button" MinWidth="90"
                                    HorizontalContentAlignment="Center" VerticalAlignment="Center" Click="BuyHoneySuper_Click" />
                        </Grid>
                        <Grid x:Name="WaxTrayRow" ColumnDefinitions="*,Auto" IsVisible="False">
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock x:Name="WaxTrayNameText" Classes="bk-body" FontWeight="SemiBold" />
                                <TextBlock x:Name="WaxTrayInfoText" Classes="bk-muted" />
                            </StackPanel>
                            <Button x:Name="BuyWaxTrayButton" Grid.Column="1" Classes="bk-button" MinWidth="90"
                                    HorizontalContentAlignment="Center" VerticalAlignment="Center" Click="BuyWaxTray_Click" />
                        </Grid>
                        <Grid x:Name="BeeswaxRow" ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock x:Name="BeeswaxNameText" Classes="bk-body" FontWeight="SemiBold" />
                                <TextBlock x:Name="BeeswaxInfoText" Classes="bk-muted" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <Button x:Name="Beeswax100Button" Classes="bk-button" MinWidth="56" Tag="Beeswax:100"
                                        HorizontalContentAlignment="Center" IsVisible="False" Click="Batch_Click" />
                                <Button x:Name="Beeswax10Button" Classes="bk-button" MinWidth="56" Tag="Beeswax:10"
                                        HorizontalContentAlignment="Center" IsVisible="False" Click="Batch_Click" />
                                <Button x:Name="CraftBeeswaxButton" Classes="bk-button" MinWidth="90"
                                        HorizontalContentAlignment="Center" Click="CraftBeeswax_Click" />
                            </StackPanel>
                        </Grid>
                        <Grid x:Name="BeeBreadRow" ColumnDefinitions="*,Auto" IsVisible="False">
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock x:Name="BeeBreadNameText" Classes="bk-body" FontWeight="SemiBold" />
                                <TextBlock x:Name="BeeBreadInfoText" Classes="bk-muted" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <Button x:Name="BeeBread100Button" Classes="bk-button" MinWidth="56" Tag="BeeBread:100"
                                        HorizontalContentAlignment="Center" IsVisible="False" Click="Batch_Click" />
                                <Button x:Name="BeeBread10Button" Classes="bk-button" MinWidth="56" Tag="BeeBread:10"
                                        HorizontalContentAlignment="Center" IsVisible="False" Click="Batch_Click" />
                                <Button x:Name="MakeBeeBreadButton" Classes="bk-button" MinWidth="90"
                                        HorizontalContentAlignment="Center" Click="MakeBeeBread_Click" />
                            </StackPanel>
                        </Grid>
                        <Grid x:Name="RepellentRow" ColumnDefinitions="*,Auto" IsVisible="False">
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock x:Name="RepellentNameText" Classes="bk-body" FontWeight="SemiBold" />
                                <TextBlock x:Name="RepellentInfoText" Classes="bk-muted" />
                                <Button x:Name="LightRepellentButton" Classes="bk-button" MinWidth="90" Margin="0,4,0,0"
                                        HorizontalAlignment="Left" HorizontalContentAlignment="Center" Click="LightRepellent_Click" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <Button x:Name="Repellent100Button" Classes="bk-button" MinWidth="56" Tag="Repellent:100"
                                        HorizontalContentAlignment="Center" IsVisible="False" Click="Batch_Click" />
                                <Button x:Name="Repellent10Button" Classes="bk-button" MinWidth="56" Tag="Repellent:10"
                                        HorizontalContentAlignment="Center" IsVisible="False" Click="Batch_Click" />
                                <Button x:Name="CraftRepellentButton" Classes="bk-button" MinWidth="90"
                                        HorizontalContentAlignment="Center" Click="CraftRepellent_Click" />
                            </StackPanel>
                        </Grid>
                        <!-- The propolis candles (stage 7): shown once the poplar has sprouted -->
                        <Grid x:Name="BeeBoostRow" ColumnDefinitions="*,Auto" IsVisible="False">
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock x:Name="BeeBoostNameText" Classes="bk-body" FontWeight="SemiBold" />
                                <TextBlock x:Name="BeeBoostInfoText" Classes="bk-muted" />
                                <Button x:Name="LightBeeBoostButton" Classes="bk-button" MinWidth="90" Margin="0,4,0,0"
                                        HorizontalAlignment="Left" HorizontalContentAlignment="Center" Click="LightBeeBoost_Click" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <Button x:Name="BeeBoost100Button" Classes="bk-button" MinWidth="56" Tag="BeeBoost:100"
                                        HorizontalContentAlignment="Center" IsVisible="False" Click="Batch_Click" />
                                <Button x:Name="BeeBoost10Button" Classes="bk-button" MinWidth="56" Tag="BeeBoost:10"
                                        HorizontalContentAlignment="Center" IsVisible="False" Click="Batch_Click" />
                                <Button x:Name="CraftBeeBoostButton" Classes="bk-button" MinWidth="90"
                                        HorizontalContentAlignment="Center" Click="CraftBeeBoost_Click" />
                            </StackPanel>
                        </Grid>
                        <Grid x:Name="SagePropolisRow" ColumnDefinitions="*,Auto" IsVisible="False">
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock x:Name="SagePropolisNameText" Classes="bk-body" FontWeight="SemiBold" />
                                <TextBlock x:Name="SagePropolisInfoText" Classes="bk-muted" />
                                <Button x:Name="LightSagePropolisButton" Classes="bk-button" MinWidth="90" Margin="0,4,0,0"
                                        HorizontalAlignment="Left" HorizontalContentAlignment="Center" Click="LightSagePropolis_Click" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <Button x:Name="SagePropolis100Button" Classes="bk-button" MinWidth="56" Tag="SagePropolis:100"
                                        HorizontalContentAlignment="Center" IsVisible="False" Click="Batch_Click" />
                                <Button x:Name="SagePropolis10Button" Classes="bk-button" MinWidth="56" Tag="SagePropolis:10"
                                        HorizontalContentAlignment="Center" IsVisible="False" Click="Batch_Click" />
                                <Button x:Name="CraftSagePropolisButton" Classes="bk-button" MinWidth="90"
                                        HorizontalContentAlignment="Center" Click="CraftSagePropolis_Click" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- THE GARDEN (from the first seed): plant, wait, sprout -->
                <Border x:Name="GardenCard" Classes="bk-card" IsVisible="False">
                    <StackPanel Spacing="10">
                        <TextBlock x:Name="GardenTitleText" Classes="bk-title" />
                        <!-- Since stage 7 (spec 015): the beds (growing or empty), the seeds in hand with a
                             Plant button each, then the plants that have sprouted. -->
                        <StackPanel x:Name="BedRows" Spacing="4" />
                        <StackPanel x:Name="SeedRows" Spacing="8" />
                        <StackPanel x:Name="PlantRows" Spacing="8" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ───────── RIGHT: wasps, story log ───────── -->
            <StackPanel Grid.Column="2" Spacing="12" VerticalAlignment="Top">
                <!-- Shown while a wasp is here or a repellent candle burns -->
                <Border x:Name="WaspCard" Classes="bk-card" IsVisible="False" BorderBrush="#66FFA38F">
                    <StackPanel Spacing="8">
                        <TextBlock x:Name="WaspTitleText" Classes="bk-title" />
                        <StackPanel x:Name="WaspHerePanel" Spacing="8">
                            <TextBlock x:Name="WaspHereText" Classes="bk-body" FontWeight="SemiBold" />
                            <TextBlock x:Name="WaspTimeText" Classes="bk-muted" />
                            <Button x:Name="ThrowShoeButton" Classes="bk-button" HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center" Click="ThrowShoe_Click" />
                            <Button x:Name="BribeButton" Classes="bk-button" HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center" Click="Bribe_Click" />
                            <Button x:Name="WaspLightButton" Classes="bk-button" HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center" Click="LightRepellent_Click" />
                        </StackPanel>
                        <TextBlock x:Name="CandleBurningText" Classes="bk-body" IsVisible="False" />
                    </StackPanel>
                </Border>

                <Border Classes="bk-card">
                    <StackPanel Spacing="10">
                        <TextBlock x:Name="LogTitleText" Classes="bk-title" />
                        <StackPanel x:Name="LogLines" Spacing="8" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
