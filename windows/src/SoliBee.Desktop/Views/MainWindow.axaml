<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:SoliBee.Desktop.Views"
        x:Class="SoliBee.Desktop.Views.MainWindow"
        Title="Honeycomb Card Suite"
        Icon="avares://Honeycomb/Assets/AppIcon.png"
        Width="1120" Height="768"
        MinWidth="400" MinHeight="300"
        WindowStartupLocation="Manual"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="-1">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Command Bar/Navigation and Stats (Colored solid background matching macOS) -->
        <!-- Command Bar/Navigation and Stats (Colored solid background matching macOS) -->
        <!-- ZIndex above VignetteOverlay (90) so toolbar buttons/stats stay unaffected by the darkening -->
        <Grid Grid.Row="0" ZIndex="100">
            <Border x:Name="TopBarBorder" Padding="15,35,15,5" Background="Transparent" PointerPressed="TopBar_PointerPressed">
                <DockPanel LastChildFill="False" Background="Transparent">
                    <!-- Buttons on the Left -->
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <ComboBox x:Name="GameSelectionBox" Classes="toolbar-combo" SelectionChanged="GameSelectionBox_SelectionChanged">
                            <ComboBoxItem x:Name="KlondikeSolibeeItem" Content="Klondike Solibee" Tag="Klondike" />
                            <ComboBoxItem x:Name="BeecellItem"         Content="Beecell"          Tag="Freecell" />
                            <ComboBoxItem x:Name="SpiderSolibeeItem"   Content="Spider Solibee"   Tag="Spider" />
                            <ComboBoxItem x:Name="VideoPokerModeItem"  Content="Video Poker"      Tag="VideoPoker" />
                            <ComboBoxItem x:Name="VideoBlackjackItem"  Content="Video Blackjack"  Tag="Blackjack" />
                            <ComboBoxItem x:Name="HoneycombModeItem"   Content="Honeycomb"        Tag="Honeycomb" />
                        </ComboBox>
                        <Button x:Name="NewGameButton" Content="New Game" Click="NewGame_Click" Classes="toolbar" />
                        <Button x:Name="RestartButton" Content="Restart" Click="RestartGame_Click" Classes="toolbar" />
                        <Button x:Name="HoneycombStartMatchButton" Content="Start Match" Click="HoneycombStartMatch_Click" Classes="toolbar" IsVisible="False" />
                        <Button x:Name="HoneycombRematchButton" Content="Rematch" Click="HoneycombRematch_Click" Classes="toolbar" IsVisible="False" />
                        <Button x:Name="HoneycombQuitMatchButton" Content="Quit Match" Click="HoneycombQuitMatch_Click" Classes="toolbar" IsVisible="False" />
                        <Button x:Name="OptionsButton" Content="Options" Click="Preferences_Click" Classes="toolbar" />
                        <Button x:Name="HoneycombRulesButton" Content="Rules" Click="HoneycombRules_Click" Classes="toolbar" IsVisible="False" />
                        <Button x:Name="HoneycombManageDecksButton" Content="Manage Decks" Click="ManageDecks_Click" Classes="toolbar" IsVisible="False" />
                        <Button x:Name="HintButton" Content="Hint" Click="Hint_Click" Classes="toolbar" />
                        <ComboBox x:Name="PokerVariantBox" Classes="toolbar-combo" IsVisible="False"
                                  SelectionChanged="PokerVariantBox_SelectionChanged">
                            <ComboBoxItem x:Name="JacksOrBetterItem" Content="Jacks or Better"/>
                            <ComboBoxItem x:Name="DeucesWildItem" Content="Deuces Wild"/>
                            <ComboBoxItem x:Name="BonusPokerItem" Content="Bonus Poker"/>
                        </ComboBox>
                        <Button x:Name="UndoButton" Content="Undo" Click="Undo_Click" Classes="toolbar" IsEnabled="{Binding CanUndo}" />
                        <Button Content="Theme Editor" Click="ThemeEditor_Click" Classes="toolbar" IsVisible="False" />
                        <Button x:Name="DebugBannerButton" Content="Banners" Classes="toolbar" IsVisible="False">
                            <Button.Flyout>
                                <MenuFlyout>
                                    <MenuItem Header="Klondike">
                                        <MenuItem Header="Win" Click="DebugBanner_Click" Tag="Klondike:Win" />
                                        <MenuItem Header="Play Win Animation" Click="DebugBanner_Click" Tag="Klondike:PlayWinAnimation" />
                                        <MenuItem Header="Loss (No Moves)" Click="DebugBanner_Click" Tag="Klondike:Loss" />
                                        <MenuItem Header="Autocomplete" Click="DebugBanner_Click" Tag="Klondike:Autocomplete" />
                                    </MenuItem>
                                    <MenuItem Header="Freecell">
                                        <MenuItem Header="Win" Click="DebugBanner_Click" Tag="Freecell:Win" />
                                        <MenuItem Header="Play Win Animation" Click="DebugBanner_Click" Tag="Freecell:PlayWinAnimation" />
                                        <MenuItem Header="Loss (No Moves)" Click="DebugBanner_Click" Tag="Freecell:Loss" />
                                        <MenuItem Header="Autocomplete" Click="DebugBanner_Click" Tag="Freecell:Autocomplete" />
                                    </MenuItem>
                                    <MenuItem Header="Spider">
                                        <MenuItem Header="Win" Click="DebugBanner_Click" Tag="Spider:Win" />
                                        <MenuItem Header="Play Win Animation" Click="DebugBanner_Click" Tag="Spider:PlayWinAnimation" />
                                        <MenuItem Header="Loss (No Moves)" Click="DebugBanner_Click" Tag="Spider:Loss" />
                                        <MenuItem Header="Autocomplete" Click="DebugBanner_Click" Tag="Spider:Autocomplete" />
                                    </MenuItem>
                                    <MenuItem Header="Video Poker">
                                        <MenuItem Header="Win" Click="DebugBanner_Click" Tag="VideoPoker:Win" />
                                        <MenuItem Header="Loss" Click="DebugBanner_Click" Tag="VideoPoker:Loss" />
                                    </MenuItem>
                                    <MenuItem Header="Blackjack">
                                        <MenuItem Header="Win" Click="DebugBanner_Click" Tag="Blackjack:Win" />
                                        <MenuItem Header="Loss" Click="DebugBanner_Click" Tag="Blackjack:Loss" />
                                    </MenuItem>
                                    <MenuItem Header="Honeycomb">
                                        <MenuItem Header="Win" Click="DebugBanner_Click" Tag="Honeycomb:Win" />
                                        <MenuItem Header="Loss" Click="DebugBanner_Click" Tag="Honeycomb:Loss" />
                                        <MenuItem Header="Draw" Click="DebugBanner_Click" Tag="Honeycomb:Draw" />
                                        <MenuItem Header="Swarm to the Death" Click="DebugBanner_Click" Tag="Honeycomb:SuddenDeath" />
                                        <Separator />
                                        <MenuItem Header="Popup: Symmetry" Click="DebugBanner_Click" Tag="Honeycomb:Same" />
                                        <MenuItem Header="Popup: Math Bee" Click="DebugBanner_Click" Tag="Honeycomb:Plus" />
                                        <MenuItem Header="Popup: Queen's Fall" Click="DebugBanner_Click" Tag="Honeycomb:FallenAce" />
                                        <MenuItem Header="Popup: Combo" Click="DebugBanner_Click" Tag="Honeycomb:Combo" />
                                    </MenuItem>
                                    <Separator />
                                    <MenuItem Header="Banner Catalog">
                                        <MenuItem Header="Loading" Click="DebugBannerCategory_Click" Tag="Loading" />
                                        <MenuItem Header="Idle Action" Click="DebugBannerCategory_Click" Tag="Idle Action" />
                                        <MenuItem Header="Gameplay" Click="DebugBannerCategory_Click" Tag="Gameplay" />
                                        <MenuItem Header="Milestones" Click="DebugBannerCategory_Click" Tag="Milestones" />
                                        <MenuItem Header="Rule-Specific" Click="DebugBannerCategory_Click" Tag="Rule-Specific" />
                                    </MenuItem>
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>
                    </StackPanel>

                    <!-- Stats on the Right -->
                    <StackPanel x:Name="StatsBarPanel" DockPanel.Dock="Right" Orientation="Horizontal" Spacing="25" VerticalAlignment="Center">
                        <!-- SCORE -->
                        <StackPanel x:Name="ScoreStatPanel" Spacing="2" HorizontalAlignment="Center">
                            <TextBlock x:Name="ScoreLabelText" Text="SCORE" FontSize="14" FontFamily="Segoe UI" FontWeight="Bold" Foreground="White" Opacity="0.6" HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding ScoreDisplay}" FontSize="20" FontFamily="Segoe UI" FontWeight="Black" Foreground="White" HorizontalAlignment="Center" />
                        </StackPanel>
                        <!-- MOVES -->
                        <StackPanel x:Name="MovesStatPanel" Spacing="2" HorizontalAlignment="Center">
                            <TextBlock x:Name="MovesLabelText" Text="MOVES" FontSize="14" FontFamily="Segoe UI" FontWeight="Bold" Foreground="White" Opacity="0.6" HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding MovesCount}" FontSize="20" FontFamily="Segoe UI" FontWeight="Black" Foreground="White" HorizontalAlignment="Center" />
                        </StackPanel>
                        <!-- TIME -->
                        <StackPanel x:Name="TimeStatPanel" Spacing="2" HorizontalAlignment="Center">
                            <TextBlock x:Name="TimeLabelText" Text="TIME" FontSize="14" FontFamily="Segoe UI" FontWeight="Bold" Foreground="White" Opacity="0.6" HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding TimeDisplay}" FontSize="20" FontFamily="Segoe UI" FontWeight="Black" Foreground="White" HorizontalAlignment="Center" />
                        </StackPanel>
                        <!-- HONEYCOMB SCORE: You -->
                        <StackPanel x:Name="HoneycombYouStatPanel" Spacing="2" HorizontalAlignment="Center" IsVisible="False">
                            <TextBlock x:Name="HoneycombYouLabelText" Text="You" FontSize="14" FontFamily="Segoe UI" FontWeight="Bold" Foreground="White" Opacity="0.6" HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding PlayerScoreDisplay}" FontSize="20" FontFamily="Segoe UI" FontWeight="Black" Foreground="White" HorizontalAlignment="Center" />
                        </StackPanel>
                        <!-- HONEYCOMB SCORE: Opponent's difficulty name (e.g. "Baby Bee") -->
                        <StackPanel x:Name="HoneycombOpponentStatPanel" Spacing="2" HorizontalAlignment="Center" IsVisible="False">
                            <TextBlock Text="{Binding OpponentNameDisplay}" FontSize="14" FontFamily="Segoe UI" FontWeight="Bold" Foreground="White" Opacity="0.6" HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding OpponentScoreDisplay}" FontSize="20" FontFamily="Segoe UI" FontWeight="Black" Foreground="White" HorizontalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </DockPanel>
            </Border>

        </Grid>

        <!-- Covers ONLY the toolbar strip — driven by BoardScrimRequestMessage (see
             MainWindow.axaml.cs). Deliberately Grid.Row="0" only, not RowSpan="2": each
             game's own local Border.banner-scrim (App.axaml) is sized (via
             SizeBannerScrimToWindow, called alongside BoardScrimRequestMessage at each
             banner's show site) to cover the entire board row itself, including the
             side/bottom margins its old tight-content-only size used to miss — see that
             method's comment. Splitting the two this way (toolbar here, everything else
             there) means the two darkening layers never cover the same pixel twice, unlike
             an earlier version that spanned both rows here and produced a visibly darker
             rectangle wherever it overlapped the local scrim. It also means a banner's own
             popup — sitting above its board's local scrim in that view's own z-order, but
             never above this element at all since this is confined to the toolbar row it
             lives nowhere near — is never darkened. IsHitTestVisible="False" (unlike
             ConfirmActionOverlay) so it never blocks toolbar clicks — these banners are
             non-modal today (toolbar stays clickable while e.g. a Win banner is up). -->
        <Grid x:Name="GlobalBannerScrim" Background="#73000000" IsVisible="False" IsHitTestVisible="False"
              HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Grid.Row="0" ZIndex="120" />

        <!-- Main Game Area -->
        <Grid x:Name="GameAreaGrid" Grid.Row="1" ClipToBounds="False" ZIndex="150">
            <!-- Starts transparent — MainWindow's Opened handler reveals it (fading in via
                 the Transitions below) only once the responsive scale-to-fit calculation
                 has settled on a stable value, so the very first launch doesn't show the
                 board briefly at the wrong size before visibly snapping to the right one. -->
            <LayoutTransformControl x:Name="MainContentWrapper" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="30,0" Opacity="0" ClipToBounds="False">
                <LayoutTransformControl.Transitions>
                    <Transitions>
                        <DoubleTransition Property="Opacity" Duration="0:0:0.25"/>
                    </Transitions>
                </LayoutTransformControl.Transitions>
                <ContentControl x:Name="MainContent" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" ClipToBounds="False" />
            </LayoutTransformControl>

            <!-- Solitaire keyboard hint row (Klondike/Freecell/Spider — Blackjack/Video
                 Poker have their own, positioned under their action buttons instead). Lives
                 outside MainContentWrapper so it isn't measured/scaled with the board: a
                 LayoutTransformControl always measures its child at infinite constraint to
                 get its natural size, so a bottom-anchored TextBlock inside the board itself
                 sits at the bottom of the board's own tight-fit content — i.e. right below
                 however tall the current tableau happens to be — not the bottom of the
                 window. Text/visibility are set per-game in MainWindow.axaml.cs. -->
            <TextBlock x:Name="SolitaireKeyHintLabel"
                       FontSize="10" Foreground="#90FFFFFF" HorizontalAlignment="Center"
                       VerticalAlignment="Bottom" IsHitTestVisible="False"
                       FontFamily="Segoe UI"
                       Margin="0,4,0,8"/>

            <!-- Honeycomb Rules Overlay -->
            <Grid x:Name="HoneycombRulesOverlay" Background="Transparent" IsVisible="False" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Grid.Row="0" Grid.RowSpan="2" ZIndex="95">
                <Grid x:Name="HoneycombRulesInset" Margin="20">
                    <Border Background="White" CornerRadius="8" Padding="20" HorizontalAlignment="Center" VerticalAlignment="Center" MaxHeight="{Binding #HoneycombRulesInset.Bounds.Height}" MaxWidth="{Binding #HoneycombRulesInset.Bounds.Width}" BoxShadow="0 4 20 0 #A0000000">
                        <Grid RowDefinitions="Auto, *">
                            <TextBlock x:Name="HoneycombRulesTitleText" Grid.Row="0" Text="Honeycomb Rules" FontSize="18" FontWeight="Bold" Foreground="#1A1A1A" HorizontalAlignment="Center" Margin="0,0,0,15" />
                            <views:HoneycombRulesView x:Name="HoneycombRulesViewControl" Grid.Row="1" />
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- Deck Builder Overlay -->
            <Grid x:Name="DeckBuilderOverlay" Background="Transparent" IsVisible="False" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Grid.Row="0" Grid.RowSpan="2" ZIndex="96">
                <Grid x:Name="DeckBuilderInset" Margin="20">
                    <!-- VerticalAlignment=Stretch keeps a constant height — with Center it
                         sized itself down to whatever the filtered Card Bank grid needed,
                         so a sparse filter (e.g. "5 Stars"+"Spades") shrank the whole
                         dialog. Width stays Center + MaxWidth instead of also stretching
                         edge-to-edge (full-width stretching left the compact title/name/
                         deck-tray content looking sparse against a huge dialog), but a
                         MaxWidth alone is only a ceiling — with very few matching cards
                         the WrapPanel's own natural width shrinks to fit just those few
                         columns, narrowing the whole dialog with it. MinWidth matching
                         MaxWidth turns it into a fixed width instead, while Avalonia's
                         Measure pass still clamps both down safely on a genuinely small
                         window. Same fix as ManageDecksPanel. -->
                    <Border Background="White" CornerRadius="16" Padding="0" HorizontalAlignment="Center" VerticalAlignment="Stretch" MinWidth="1000" MaxWidth="1000" BoxShadow="0 4 20 0 #A0000000">
                        <ContentControl x:Name="DeckBuilderContent" />
                    </Border>
                </Grid>
            </Grid>

            <!-- Preferences Modal Dialog Overlay — spans both rows (Grid.RowSpan) so it
                 covers the full window instead of just Row 0's Auto-sized toolbar strip,
                 which otherwise made the panel center within that thin strip instead of
                 the whole window (ZIndex above VignetteOverlay so its buttons stay unaffected) -->
            <Grid x:Name="PreferencesOverlay" Background="Transparent" IsVisible="False" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Grid.Row="0" Grid.RowSpan="2" ZIndex="95">
                <!-- Insets the panel so its bound MaxHeight below leaves breathing room
                     instead of touching the window edges exactly. -->
                <Grid x:Name="PreferencesInset" Margin="20">
                    <!-- Caps the panel to the available window height (per-game window sizes
                         vary — e.g. Freecell's taller board) and makes the settings content
                         scroll internally instead of being silently clipped off the bottom,
                         while the title and Cancel/OK/View Stats row stay always visible. -->
                    <Border x:Name="PreferencesPanel" Background="White" CornerRadius="8" Padding="20" HorizontalAlignment="Center" VerticalAlignment="Center" MaxHeight="{Binding #PreferencesInset.Bounds.Height}" BoxShadow="0 4 20 0 #A0000000">
                        <Grid RowDefinitions="Auto,*,Auto">
                            <!-- Constrained watermark (matches Stats/Rules) — shared across every
                                 game's Preferences panel since this Grid is the common chrome for
                                 all of them. Fixed max size so it sits behind the content instead
                                 of scaling with however tall a given game's options page is.
                                 Anchored upper-right (below the Language row, over the checkbox
                                 list) rather than centered — Windows-only positioning choice, no
                                 equivalent change on Mac.
                                 Wrapped in a Border instead of toggling the Image's own IsVisible
                                 from code-behind, so the existing {Binding !HideBee} stays live —
                                 setting IsVisible imperatively would replace that binding outright.
                                 PreferencesWatermarkWrapper is hidden from code-behind specifically
                                 while the Face Cards panel is open: that panel's own card grid has
                                 no opaque background filling the space around it, so this watermark
                                 was showing through a second time next to the tiles, on top of the
                                 large one already visible where the board isn't covered by the
                                 dialog. -->
                            <Border x:Name="PreferencesWatermarkWrapper" Grid.Row="0" Grid.RowSpan="3">
                                <Image Source="avares://Honeycomb/Assets/solibee.png" Opacity="0.15" Stretch="Uniform"
                                       MaxWidth="220" MaxHeight="220" HorizontalAlignment="Right" VerticalAlignment="Top"
                                       Margin="0,100,0,0"
                                       IsHitTestVisible="False"
                                       IsVisible="{Binding !HideBee}" />
                            </Border>

                            <!-- Header row: shared "‹ Back" chip (left, hidden on the main
                                 Preferences page) + centered title — PreferencesView toggles
                                 this instead of each of its Themes/Face Cards/Card Colors
                                 sub-panels drawing its own Back button above its content. -->
                            <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,15">
                                <Button x:Name="PreferencesBackButton" Grid.Column="0" Click="PreferencesBackButton_Click"
                                        Classes="theme-back" IsVisible="False"
                                        HorizontalAlignment="Left" HorizontalContentAlignment="Left" Padding="10,6"
                                        BorderThickness="0">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <TextBlock Text="‹" FontSize="17" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="PreferencesBackLabelText" Text="Back" FontSize="13" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <TextBlock x:Name="PreferencesTitleText" Grid.Column="1" Text="Preferences" FontSize="18" FontWeight="Bold" Foreground="#1A1A1A" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <ContentControl x:Name="PreferencesContent" />
                            </ScrollViewer>
                            <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" Margin="0,15,0,0">
                                <TextBlock x:Name="ViewStatsText" Text="View Stats" Grid.Column="0"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="#1155AA" TextDecorations="Underline"
                                           Cursor="Hand" PointerPressed="ViewStats_PointerPressed"/>
                                <Button x:Name="CancelPreferencesButton" Classes="light-secondary" Content="Cancel" Click="CancelPreferences_Click" Grid.Column="1"
                                        Width="80" HorizontalContentAlignment="Center" Margin="0,0,8,0" />
                                <Button x:Name="OkPreferencesButton" Classes="light-primary" Content="OK" Click="ClosePreferences_Click" Grid.Column="2"
                                        Width="80" HorizontalContentAlignment="Center" />
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- Manage Decks Overlay -->
            <Grid x:Name="ManageDecksOverlay" Background="Transparent" IsVisible="False" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Grid.Row="0" Grid.RowSpan="2" ZIndex="95">
                <Grid x:Name="ManageDecksInset" Margin="20">
                    <!-- VerticalAlignment=Stretch fills the inset's height instead of
                         sizing-to-content: with Center alignment the panel shrank to fit
                         whatever the filtered card grid needed, so narrowing a filter down
                         to 1-2 cards made the whole dialog jarringly collapse. Width stays
                         Center + MaxWidth rather than also stretching horizontally
                         (stretching edge-to-edge on wide windows left the dialog looking
                         sparse/oversized instead of matching Mac's compact centered
                         dialog), but MaxWidth alone is only a ceiling — with very few
                         matching cards (e.g. the freeform stat search down to 1-2 results)
                         the card grid's own natural width shrinks to fit just those few
                         columns, narrowing the whole dialog with it. MinWidth matching
                         MaxWidth turns it into a fixed width instead; Avalonia's Measure
                         pass still clamps both down safely on a genuinely narrow window. -->
                    <Border x:Name="ManageDecksPanel" Background="White" CornerRadius="8" Padding="20" HorizontalAlignment="Center" VerticalAlignment="Stretch" MinWidth="1000" MaxWidth="1000" BoxShadow="0 4 20 0 #A0000000">
                        <Grid RowDefinitions="Auto,*,Auto">
                            <Grid Grid.Row="0" Margin="0,0,0,15">
                                <TextBlock x:Name="ManageDecksTitleText" Text="Manage Decks" FontSize="18" FontWeight="Bold" Foreground="#1A1A1A" HorizontalAlignment="Center" />
                            </Grid>
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <ContentControl x:Name="ManageDecksContent" />
                            </ScrollViewer>
                            <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,15,0,0">
                                <Button x:Name="DoneManageDecksButton" Classes="light-primary" Content="Done" Click="CloseManageDecks_Click" Grid.Column="1" Width="100" HorizontalContentAlignment="Center" />
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- Stats Modal Dialog Overlay — same Grid.RowSpan fix as PreferencesOverlay above,
                 so it centers in the full window instead of just Row 0's toolbar strip
                 (ZIndex above VignetteOverlay so its buttons stay unaffected) -->
            <Grid x:Name="StatsOverlay" Background="#90000000" IsVisible="False" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Grid.Row="0" Grid.RowSpan="2" ZIndex="95">
                <Border Background="White" CornerRadius="8" ClipToBounds="True" HorizontalAlignment="Center" VerticalAlignment="Center" BoxShadow="0 4 20 0 #A0000000">
                    <Grid>
                        <!-- Constrained to a fixed max size (not left to scale with the panel) —
                             the panel just widened for the two-column stat grid below, and an
                             unconstrained Stretch="Uniform" image grows to fill that extra width,
                             overpowering the stat text instead of sitting behind it as a watermark. -->
                        <Image Source="avares://Honeycomb/Assets/solibee.png" Opacity="0.15" Stretch="Uniform"
                               MaxWidth="220" MaxHeight="220" HorizontalAlignment="Center" VerticalAlignment="Center"
                               IsVisible="{Binding !HideBee}" />

                    <!-- Width is fixed per-panel in code-behind (PopulateStatsPanel's callees) —
                         460 for Klondike/Freecell/Spider's two-column StatsFixedRows grid below,
                         300 for Blackjack/Video Poker's single column, wider still (620) for
                         Honeycomb's two-column layout (StatsDynamicRowsCol1/Col2 below), so its
                         long stat list doesn't stretch the popup so tall. -->
                    <StackPanel x:Name="StatsPanelRoot" Spacing="14" Width="300" Margin="24">
                        <TextBlock x:Name="StatsTitleText" Text="Klondike Statistics" FontSize="18" FontWeight="Bold" Foreground="#1A1A1A" HorizontalAlignment="Center" />
                        <Rectangle Height="1" Fill="#DDDDDD" />
                        <!-- Two-column stat grid — each grid row holds one left/right pair (e.g.
                             Games Played | Current Streak), with a divider row spanning both
                             columns between them, matching the design refresh mockup. Labels
                             are a smaller muted gray to push them back visually behind the
                             bold, larger value text (see design_proposal.md's typography spec). -->
                        <Grid x:Name="StatsFixedRows" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto">
                            <Grid Grid.Row="0" Grid.Column="0" ColumnDefinitions="*,Auto" Margin="0,10,14,10">
                                <TextBlock x:Name="StatsGamesPlayedLabel" Text="Games Played" FontSize="13" Foreground="#707070" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" x:Name="StatsGamesPlayedText" FontSize="17" FontWeight="Black" Foreground="#1A1A1A" VerticalAlignment="Center" />
                            </Grid>
                            <Grid Grid.Row="0" Grid.Column="1" ColumnDefinitions="*,Auto" Margin="14,10,0,10">
                                <TextBlock x:Name="StatsCurrentStreakLabel" Text="Current Streak" FontSize="13" Foreground="#707070" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" x:Name="StatsCurrentStreakText" FontSize="17" FontWeight="Black" Foreground="#1A1A1A" VerticalAlignment="Center" />
                            </Grid>

                            <Rectangle Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Height="1" Fill="#DDDDDD" />

                            <Grid Grid.Row="2" Grid.Column="0" ColumnDefinitions="*,Auto" Margin="0,10,14,10">
                                <TextBlock x:Name="StatsGamesWonLabel" Text="Games Won" FontSize="13" Foreground="#707070" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" x:Name="StatsGamesWonText" FontSize="17" FontWeight="Black" Foreground="#1A1A1A" VerticalAlignment="Center" />
                            </Grid>
                            <Grid Grid.Row="2" Grid.Column="1" ColumnDefinitions="*,Auto" Margin="14,10,0,10">
                                <TextBlock x:Name="StatsLongestStreakLabel" Text="Longest Streak" FontSize="13" Foreground="#707070" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" x:Name="StatsLongestStreakText" FontSize="17" FontWeight="Black" Foreground="#1A1A1A" VerticalAlignment="Center" />
                            </Grid>

                            <Rectangle Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Height="1" Fill="#DDDDDD" />

                            <Grid Grid.Row="4" Grid.Column="0" ColumnDefinitions="*,Auto" Margin="0,10,14,10">
                                <TextBlock x:Name="StatsHighScoreLabel" Text="High Score" FontSize="13" Foreground="#707070" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" x:Name="StatsHighScoreText" FontSize="17" FontWeight="Black" Foreground="#1A1A1A" VerticalAlignment="Center" />
                            </Grid>
                            <Grid Grid.Row="4" Grid.Column="1" ColumnDefinitions="*,Auto" Margin="14,10,0,10">
                                <TextBlock x:Name="StatsAvgWinTimeLabel" Text="Avg Winning Time" FontSize="13" Foreground="#707070" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" x:Name="StatsAvgWinTimeText" FontSize="17" FontWeight="Black" Foreground="#1A1A1A" VerticalAlignment="Center" />
                            </Grid>

                            <Rectangle Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" Height="1" Fill="#DDDDDD" />

                            <Grid Grid.Row="6" Grid.Column="0" ColumnDefinitions="*,Auto" Margin="0,10,14,10">
                                <TextBlock x:Name="StatsWinPctLabel" Text="Win Percentage" FontSize="13" Foreground="#707070" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" x:Name="StatsWinPctText" FontSize="17" FontWeight="Black" Foreground="#1A1A1A" VerticalAlignment="Center" />
                            </Grid>
                            <Grid Grid.Row="6" Grid.Column="1" ColumnDefinitions="*,Auto" Margin="14,10,0,10">
                                <TextBlock x:Name="StatsFastestWinLabel" Text="Fastest Win" FontSize="13" Foreground="#707070" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" x:Name="StatsFastestWinText" FontSize="17" FontWeight="Black" Foreground="#1A1A1A" VerticalAlignment="Center" />
                            </Grid>
                        </Grid>
                        <!-- Blackjack / Video Poker / Honeycomb have different field sets, so
                             their rows are built in code-behind rather than fixed like above.
                             Two side-by-side columns — Blackjack/VideoPoker only ever populate
                             Col1 and hide Col2; Honeycomb (many more rows) splits across both so
                             its popup doesn't stretch so tall. -->
                        <Grid x:Name="StatsDynamicRows" IsVisible="False" ColumnDefinitions="*,*">
                            <StackPanel x:Name="StatsDynamicRowsCol1" Grid.Column="0" Spacing="8" />
                            <StackPanel x:Name="StatsDynamicRowsCol2" Grid.Column="1" Spacing="8" Margin="20,0,0,0" IsVisible="False" />
                        </Grid>
                        <Rectangle Height="1" Fill="#DDDDDD" />
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Button x:Name="ResetStatsButton" Content="Reset Stats" Click="ResetStats_Click" Grid.Column="0"
                                    Classes="light-danger" Width="100" HorizontalContentAlignment="Center" BorderThickness="0" />
                            <Button x:Name="CloseStatsButton" Content="Close" Click="CloseStats_Click" Grid.Column="2"
                                    Width="80" HorizontalContentAlignment="Center" Classes="light-secondary" />
                        </Grid>
                    </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- Game Action Confirmation Overlay — moved out of GameAreaGrid (which only occupies
             root Grid.Row="1", below the toolbar) up to root level so Grid.RowSpan="2" actually
             spans both root rows and the scrim covers the toolbar too, not just the board.
             ZIndex above the toolbar (100) so it actually blocks toolbar clicks (e.g.
             GameSelectionBox/PokerVariantBox) while a confirmation is pending; otherwise a
             second toolbar action could silently swap out _pendingAction with no acknowledgment
             that the first request was dropped. -->
        <Grid x:Name="ConfirmActionOverlay" Background="#73000000" IsVisible="False" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Grid.Row="0" Grid.RowSpan="2" ZIndex="200">
            <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
                <Border Classes="banner-glow" Background="#BF000000" CornerRadius="12" Padding="24,24" MaxWidth="380">
                    <StackPanel Spacing="12" HorizontalAlignment="Center" Width="300">
                        <TextBlock x:Name="ConfirmActionTitle" Text="Start New Game?" FontSize="36" FontWeight="Black" Foreground="#FFD600" HorizontalAlignment="Center" FontFamily="Segoe UI" TextAlignment="Center" TextWrapping="Wrap" />
                        <TextBlock x:Name="ConfirmActionMessage" Text="Are you sure you want to abandon the current game and start a new one?" FontSize="14" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" FontFamily="Segoe UI" TextAlignment="Center" TextWrapping="Wrap" />
                        <WrapPanel HorizontalAlignment="Center" Margin="0,12,0,0">
                            <Button x:Name="ConfirmActionButton" Classes="banner-action" Content="New Game" Click="ConfirmAction_Click" Margin="0,0,12,8" />
                            <Button x:Name="CancelConfirmActionButton" Classes="banner-action" Content="Cancel" Click="CancelConfirmAction_Click" Margin="0,0,0,8" />
                        </WrapPanel>
                    </StackPanel>
                </Border>
                <!-- Dismiss button anchored TopRight, overlapping corner -->
                <Button Width="20" Height="20" Padding="0" Background="Transparent" BorderThickness="0"
                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,8,0"
                        Foreground="#B3FFFFFF" FontSize="16" Content="✕" Click="CancelConfirmAction_Click"/>
            </Grid>
        </Grid>

        <!-- Custom board background image (replaces flat felt color when set) — sits behind
             everything, ZIndex set at runtime in ApplyBoardBackground (below VignetteOverlay's
             runtime ZIndex so the vignette still darkens it the same way it darkens felt color) -->
        <Image x:Name="BoardBackgroundImage" Grid.Row="0" Grid.RowSpan="2"
               IsHitTestVisible="False" IsVisible="False" Stretch="UniformToFill" ZIndex="80"
               RenderOptions.BitmapInterpolationMode="HighQuality" />

        <!-- App-wide Vignette depth overlay (covers both top bar and game board) -->
        <Rectangle x:Name="VignetteOverlay" Grid.Row="0" Grid.RowSpan="2" IsHitTestVisible="False" IsVisible="False" ZIndex="90"
                   HorizontalAlignment="Center" VerticalAlignment="Center">
            <Rectangle.Fill>
                <RadialGradientBrush Center="50%,50%">
                    <GradientStop Color="#00000000" Offset="0.15"/>
                    <GradientStop Color="#57000000" Offset="1.0"/>
                </RadialGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
    </Grid>

    <Window.Styles>
        <!-- Toolbar Button Styles -->
        <Style Selector="Button.toolbar">
            <Setter Property="Background" Value="#26FFFFFF" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="White" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="RenderTransform" Value="scale(1)" />
            <Setter Property="Transitions">
                <Setter.Value>
                    <Transitions>
                        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.08"/>
                    </Transitions>
                </Setter.Value>
            </Setter>
        </Style>
        <Style Selector="Button.toolbar:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#40FFFFFF" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="White" />
        </Style>
        <Style Selector="Button.toolbar:pointerover">
            <Setter Property="RenderTransform" Value="scale(1.04)" />
        </Style>
        <Style Selector="Button.toolbar:pressed">
            <Setter Property="RenderTransform" Value="scale(0.93)" />
        </Style>
        
        <!-- Toolbar ComboBox Styles -->
        <Style Selector="ComboBox.toolbar-combo">
            <Setter Property="Background" Value="#26FFFFFF" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="White" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style Selector="ComboBox.toolbar-combo:pointerover /template/ Border">
            <Setter Property="Background" Value="#40FFFFFF" />
            <Setter Property="BorderBrush" Value="White" />
        </Style>
        <Style Selector="ComboBox.toolbar-combo /template/ PathIcon">
            <Setter Property="Foreground" Value="White" />
        </Style>

    </Window.Styles>
</Window>
