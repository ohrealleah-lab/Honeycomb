<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SoliBee.Desktop.Views"
             x:Class="SoliBee.Desktop.Views.HoneycombCardView"
             PointerPressed="Card_PointerPressed">

    <Grid x:Name="CardRoot" Width="195" Height="276">
        <!-- Flip Container for animation -->
        <Border x:Name="FlipContainer" RenderTransformOrigin="50%,50%">
            <!-- Card Face -->
            <Border x:Name="CardFace" BorderBrush="#D9000000" BorderThickness="1.5" Background="#F0F0F0" CornerRadius="10" ClipToBounds="True">
                <Grid>
                    <!-- Center Suit Glyph -->
                    <Image x:Name="SuitImage" Width="150" Height="150" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapInterpolationMode="MediumQuality" />
                    
                    <!-- Star Rating Layout -->
                    <StackPanel x:Name="StarsPanel" Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="1" />
                    
                    <!-- The 4 Stats. Point Highlights (see SetStatHighlight) recolors the
                         number itself gold and briefly pulses its scale — matching Mac's
                         HoneycombCardView — rather than any border/edge flash. -->
                    <TextBlock x:Name="TopStat" FontSize="32" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,15,0,0" RenderTransformOrigin="0.5,0.5">
                        <TextBlock.RenderTransform>
                            <ScaleTransform ScaleX="1" ScaleY="1">
                                <ScaleTransform.Transitions>
                                    <Transitions>
                                        <DoubleTransition Property="ScaleX" Duration="0:0:0.15" Easing="CubicEaseOut" />
                                        <DoubleTransition Property="ScaleY" Duration="0:0:0.15" Easing="CubicEaseOut" />
                                    </Transitions>
                                </ScaleTransform.Transitions>
                            </ScaleTransform>
                        </TextBlock.RenderTransform>
                    </TextBlock>
                    <TextBlock x:Name="RightStat" FontSize="32" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" RenderTransformOrigin="0.5,0.5">
                        <TextBlock.RenderTransform>
                            <ScaleTransform ScaleX="1" ScaleY="1">
                                <ScaleTransform.Transitions>
                                    <Transitions>
                                        <DoubleTransition Property="ScaleX" Duration="0:0:0.15" Easing="CubicEaseOut" />
                                        <DoubleTransition Property="ScaleY" Duration="0:0:0.15" Easing="CubicEaseOut" />
                                    </Transitions>
                                </ScaleTransform.Transitions>
                            </ScaleTransform>
                        </TextBlock.RenderTransform>
                    </TextBlock>
                    <TextBlock x:Name="BottomStat" FontSize="32" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,15" RenderTransformOrigin="0.5,0.5">
                        <TextBlock.RenderTransform>
                            <ScaleTransform ScaleX="1" ScaleY="1">
                                <ScaleTransform.Transitions>
                                    <Transitions>
                                        <DoubleTransition Property="ScaleX" Duration="0:0:0.15" Easing="CubicEaseOut" />
                                        <DoubleTransition Property="ScaleY" Duration="0:0:0.15" Easing="CubicEaseOut" />
                                    </Transitions>
                                </ScaleTransform.Transitions>
                            </ScaleTransform>
                        </TextBlock.RenderTransform>
                    </TextBlock>
                    <TextBlock x:Name="LeftStat" FontSize="32" FontWeight="Bold" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0" RenderTransformOrigin="0.5,0.5">
                        <TextBlock.RenderTransform>
                            <ScaleTransform ScaleX="1" ScaleY="1">
                                <ScaleTransform.Transitions>
                                    <Transitions>
                                        <DoubleTransition Property="ScaleX" Duration="0:0:0.15" Easing="CubicEaseOut" />
                                        <DoubleTransition Property="ScaleY" Duration="0:0:0.15" Easing="CubicEaseOut" />
                                    </Transitions>
                                </ScaleTransform.Transitions>
                            </ScaleTransform>
                        </TextBlock.RenderTransform>
                    </TextBlock>
                    
                    <!-- Modifier Badge (+N / -N) in top-left corner -->
                    <Border x:Name="ModifierBadge" IsVisible="False" Background="#404040" CornerRadius="4" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="4,4,0,0" Padding="3,1">
                        <TextBlock x:Name="ModifierText" Foreground="White" FontSize="12" FontWeight="Bold" />
                    </Border>
                    
                    <!-- Top Right Ascension/Descension Modifier -->
                    <TextBlock x:Name="AscensionModifierText" FontSize="25" FontWeight="Black" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,8,0" IsVisible="False">
                        <TextBlock.Effect>
                            <DropShadowEffect BlurRadius="4" Color="White" Opacity="0.8" />
                        </TextBlock.Effect>
                    </TextBlock>
                </Grid>
            </Border>
        </Border>

        <!-- Card Back — a single direct Image at this control's own real card size,
             not a fixed-128×181 CardView stretched up via Viewbox (that rendered the
             art down to 128×181 first, then blew the result back up ~1.5x to
             Honeycomb's actual 195×276 card, blurring it unconditionally regardless of
             window size — see CardView.ResolveCardBackBitmap's comment). -->
        <Border x:Name="CardBack" BorderBrush="#D9000000" BorderThickness="1.5" CornerRadius="10" IsVisible="False" ClipToBounds="True" Background="White" RenderTransformOrigin="50%,50%">
            <Image x:Name="CardBackImage" Width="195" Height="276" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapInterpolationMode="MediumQuality" />
        </Border>

        <!-- Steal/Order/Chaos/Swap Highlight Border — a direct CardRoot sibling of
             FlipContainer and CardBack (not nested inside CardFace) so it renders
             regardless of whether the card is currently showing face or back. It used
             to live inside CardFace's Grid, which meant a highlighted-but-still-hidden
             opponent hand card (e.g. Nectar Exchange's swap highlight, or an Order/
             Chaos mandated-card highlight on the opponent's side) never actually showed
             the border, since CardFace itself is invisible while CardBack is showing. -->
        <Border x:Name="StealHighlightBorder" IsVisible="False" BorderBrush="Yellow" BorderThickness="8" CornerRadius="10" IsHitTestVisible="False" />
    </Grid>
</UserControl>
