<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- Release publish shouldn't ship .pdb debug-symbol files alongside the exe.
       Scoped to Release only so Debug builds still get symbols for local debugging. -->
  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <DebugType>none</DebugType>
  </PropertyGroup>

  <!-- Lets the tests stand in a fake of Windows' per-app storage (SettingsService.LocalSettingsOverride). -->
  <ItemGroup>
    <InternalsVisibleTo Include="SoliBee.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Velopack" Version="1.2.0" />
  </ItemGroup>

</Project>
