<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SoliBee.Desktop.Views.HoneycombRulesView">

    <Grid RowDefinitions="Auto, Auto, *, Auto">
        <!-- Difficulty at top -->
        <Grid Grid.Row="0" Margin="0,15,0,10" ColumnDefinitions="*,Auto">
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6">
                <TextBlock x:Name="OpponentLabel" Text="Opponent:" FontSize="13" FontWeight="SemiBold" Foreground="#1A1A1A" VerticalAlignment="Center"/>
                <ComboBox x:Name="HoneycombDifficultyCombo" Width="120" SelectionChanged="HoneycombDifficultyCombo_SelectionChanged">
                    <ComboBoxItem x:Name="BabyBeeItem" Content="Baby Bee" Tag="Easy"/>
                    <ComboBoxItem x:Name="HoneyBeeItem" Content="Honey Bee" Tag="Medium"/>
                    <ComboBoxItem x:Name="QueenBeeItem" Content="Queen Bee" Tag="Hard"/>
                    <ComboBoxItem x:Name="KillerBeeItem" Content="Killer Bee" Tag="UltraHard"/>
                </ComboBox>
            </StackPanel>
            <!-- No explicit FontSize — inherits the same ambient size the ComboBox's
                 own text uses (it doesn't set one either), so the two match instead of
                 the button's text reading noticeably smaller. -->
            <Button Grid.Column="1" x:Name="HoneycombHelpButton" Content="Honeycomb Help" Classes="light-secondary" Click="HoneycombHelp_Click"
                    Padding="10,4" VerticalAlignment="Center" />
        </Grid>

        <!-- Header block — moved out of the ScrollViewer below so "Ban?"/"Play" and
             the instructions stay pinned in place; only the rule rows themselves
             should scroll. -->
        <StackPanel Grid.Row="1">
            <Rectangle Height="1" Fill="#DDDDDD" Margin="0,0,0,15" />

            <!-- One merged list instead of two independent full-length columns
                 (Game Choice + Ban List) that each restated all 13-14 rule names
                 on their own. Ban checkbox first (leftmost, matches the mockup),
                 then the roulette-pool Select checkbox, then the rule name once.
                 "Inversion" only exists in the ban set (no HoneycombRule enum
                 value — it can never be manually selected, only banned from the
                 roulette pool), so its row has no Select checkbox. -->
            <!-- Fixed (not Auto) widths: this header Grid and the checkbox Grid below it
                 size independently, so Auto columns here never actually matched the
                 checkboxes' own Auto width below — harmless for the short English "Ban?"/
                 "Play" labels, but "¿Vetar?" (translated, longer, needs its trailing "?"
                 visible) overflowed past a width sized only for "Ban?". Fixed widths keep
                 both Grids' columns matched regardless of translation length, and give the
                 checkboxes below more breathing room besides. -->
            <Grid ColumnDefinitions="50,58,*" Margin="0,0,0,6">
                <TextBlock x:Name="BanColumnHeaderText" Grid.Column="0" Text="Ban?" FontSize="11" FontWeight="Bold" Foreground="#707070"
                           TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" Margin="2,0"/>
                <TextBlock x:Name="PlayColumnHeaderText" Grid.Column="1" Text="Play" FontSize="11" FontWeight="Bold" Foreground="#707070"
                           TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" Margin="2,0"/>
                <!-- Right margin clears the ScrollViewer's own scrollbar gutter — without
                     it this text wrapped right up against (and visually under) the
                     scrollbar instead of leaving it clear space. -->
                <StackPanel Grid.Column="2" Margin="10,0,20,0">
                    <TextBlock x:Name="MatchRulesHintText" Text="Select up to 4 rules. Leave empty to let roulette decide each match's rules."
                               FontSize="11" Foreground="#707070" TextWrapping="Wrap"/>
                    <TextBlock x:Name="BanRemovesRuleHintText" Text="Ban removes a rule from the roulette pool entirely."
                               FontSize="11" Foreground="#707070" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
        </StackPanel>

        <!-- Scrollable rule rows only -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- ToolTip.ShowDelay (ms) makes each rule's hover explanation match the
                     same "hold for a beat" pacing as the mac port's .help() tooltips.
                     Column widths (50,58) match the header Grid above, not Auto — see
                     that Grid's own comment. -->
                <Grid ColumnDefinitions="50,58,*"
                      RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
                    <!-- Centers every checkbox within its now-wider fixed column instead
                         of them hugging the left edge, so each sits under its header
                         label ("¿Vetar?"/"Jugar") instead of bunched together. -->
                    <Grid.Styles>
                        <Style Selector="CheckBox">
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                        </Style>
                    </Grid.Styles>

                    <CheckBox Grid.Row="0" Grid.Column="0" x:Name="Ban_NormalMode" Tag="Normal Mode" Checked="BanRule_Changed" Unchecked="BanRule_Changed" ToolTip.ShowDelay="1000" ToolTip.Tip="Forces a match with no active rules, skipping roulette."/>
                    <CheckBox Grid.Row="0" Grid.Column="1" x:Name="HoneycombRule_ForceNormal" Tag="ForceNormal" Checked="HoneycombRule_Changed" Unchecked="HoneycombRule_Changed" ToolTip.ShowDelay="1000" ToolTip.Tip="Forces a match with no active rules, skipping roulette."/>
                    <TextBlock x:Name="RuleLabel_NormalMode" Grid.Row="0" Grid.Column="2" Text="Normal Mode (Force Zero Rules)" Foreground="#1A1A1A" VerticalAlignment="Center" Margin="10,4,0,4" ToolTip.ShowDelay="1000" ToolTip.Tip="Forces a match with no active rules, skipping roulette."/>

                    <CheckBox Grid.Row="1" Grid.Column="0" x:Name="Ban_Ascension" Tag="Ascension" Checked="BanRule_Changed" Unchecked="BanRule_Changed" ToolTip.ShowDelay="1000" ToolTip.Tip="Grants +1 to stats for cards matching randomly selected suits placed on the board."/>
                    <CheckBox Grid.Row="1" Grid.Column="1" x:Name="HoneycombRule_Ascension" Tag="Ascension" Checked="HoneycombRule_Changed" Unchecked="HoneycombRule_Changed" ToolTip.ShowDelay="1000" ToolTip.Tip="Grants +1 to stats for cards matching randomly selected suits placed on the board."/>
                    <TextBlock x:Name="RuleLabel_Ascension" Grid.Row="1" Grid.Column="2" Text="Pollination" Foreground="#1A1A1A" VerticalAlignment="Center" Margin="10,4,0,4" ToolTip.ShowDelay="1000" ToolTip.Tip="Grants +1 to stats for cards matching randomly selected suits placed on the board."/>

                    <CheckBox Grid.Row="2" Grid.Column="0" x:Name="Ban_Descension" Tag="Descension" Checked="BanRule_Changed" Unchecked="BanRule_Changed" ToolTip.ShowDelay="1000" ToolTip.Tip="Inflicts -1 to stats for cards matching randomly selected suits placed on the board."/>
                    <CheckBox Grid.Row="2" Grid.Column="1" x:Name="HoneycombRule_Descension" Tag="Descension" Checked="HoneycombRule_Changed" Unchecked="HoneycombRule_Changed" ToolTip.ShowDelay="1000" ToolTip.Tip="Inflicts -1 to stats for cards matching randomly selected suits placed on the board."/>
                    <TextBlock x:Name="RuleLabel_Descension" Grid.Row="2" Grid.Column="2" Text="Smoked Out" Foreground="#1A1A1A" VerticalAlignment="Center" Margin="10,4,0,4" ToolTip.ShowDelay="1000" ToolTip.Tip="Inflicts -1 to stats for cards matching randomly selected suits placed on the board."/>

                    <CheckBox Grid.Row="3" Grid.Column="0" x:Name="Ban_Same" Tag="Same" Checked="BanRule_Changed" Unchecked="BanRule_Changed" ToolTip.ShowDelay="1000" ToolTip.Tip="If 2+ touching neighbor stats match your card's facing stats, all matching neighbors are captured simultaneously."/>
                    <CheckBox Grid.Row="3" Grid.Column="1" x:Name="HoneycombRule_Same" Tag="Same" Checked="HoneycombRule_Changed" Unchecked="HoneycombRule_Changed" ToolTip.ShowDelay="1000" ToolTip.Tip="If 2+ touching neighbor stats match your card's facing stats, all matching neighbors are captured simultaneously."/>
                    <TextBlock x:Name="RuleLabel_Same" Grid.Row="3" Grid.Column="2" Text="Symmetry" Foreground="#1A1A1A" VerticalAlignment="Center" Margin="10,4,0,4" ToolTip.ShowDelay="1000" ToolTip.Tip="If 2+ touching neighbor stats match your card's facing stats, all matching neighbors are captured simultaneously."/>

                    <CheckBox Grid.Row="4" Grid.Column="0" x:Name="Ban_Plus" Tag="Plus" Checked="BanRule_Changed" Unchecked="BanRule_Changed" ToolTip.ShowDelay="1000" ToolTip.Tip="If the sum of (your stat + neighbor's stat) equals the same total across 2+ neighbors, all involved cards are captured."/>
                    <CheckBox Grid.Row="4" Grid.Column="1" x:Name="HoneycombRule_Plus" Tag="Plus" Checked="HoneycombRule_Changed" Unchecked="HoneycombRule_Changed" ToolTip.ShowDelay="1000" ToolTip.Tip="If the sum of (your stat + neighbor's stat) equals the same total across 2+ neighbors, all involved cards are captured."/>
                    <TextBlock x:Name="RuleLabel_Plus" Grid.Row="4" Grid.Column="2" Text="Math Bee" Foreground="#1A1A1A" VerticalAlignment="Center" Margin="10,4,0,4" ToolTip.ShowDelay="1000" ToolTip.Tip="If the sum of (your stat + neighbor's stat) equals the same total across 2+ neighbors, all involved cards are captured."/>

                    <CheckBox Grid.Row="5" Grid.Column="0" x:Name="Ban_FallenAce" Tag="FallenAce" Checked="BanRule_Changed" Unchecked="BanRule_Changed" ToolTip.ShowDelay="1000" ToolTip.Tip="A stat of A (10) can be captured by a stat of 1. If Inversion is also active, this flips: a stat of A captures a stat of 1 instead."/>
                    <CheckBox Grid.Row="5" Grid.Column="1" x:Name="HoneycombRule_FallenAce" Tag="FallenAce" Checked="HoneycombRule_Changed" Unchecked="HoneycombRule_Changed" ToolTip.ShowDelay="1000" ToolTip.Tip="A stat of A (10) can be captured by a stat of 1. If Inversion is also active, this flips: a stat of A captures a stat of 1 instead."/>
                    <TextBlock x:Name="RuleLabel_FallenAce" Grid.Row="5" Grid.Column="2" Text="Queen's Fall" Foreground="#1A1A1A" VerticalAlignment="Center" Margin="10,4,0,4" ToolTip.ShowDelay="1000" ToolTip.Tip="A stat of A (10) can be captured by a stat of 1. If Inversion is also active, this flips: a stat of A captures a stat of 1 instead."/>

                    <CheckBox Grid.Row="6" Grid.Column="0" x:Name="Ban_AllOpen" Tag="AllOpen" Checked="BanRule_Changed" Unchecked="BanRule_Changed" ToolTip.ShowDelay="1000" ToolTip.Tip="Both players' hands are completely visible."/>
                    <CheckBox Grid.Row="6" Grid.Column="1" x:Name="HoneycombRule_AllOpen" Tag="AllOpen" Checked="HoneycombRule_Changed" Unchecked="HoneycombRule_Changed" ToolTip.ShowDelay="1000" ToolTip.Tip="Both players' hands are completely visible."/>
                    <TextBlock x:Name="RuleLabel_AllOpen" Grid.Row="6" Grid.Column="2" Text="Clear Skies" Foreground="#1A1A1A" VerticalAlignment="Center" Margin="10,4,0,4" ToolTip.ShowDelay="1000" ToolTip.Tip="Both players' hands are completely visible."/>

                    <CheckBox Grid.Row="7" Grid.Column="0" x:Name="Ban_ThreeOpen" Tag="ThreeOpen" Checked="BanRule_Changed" Unchecked="BanRule_Changed" ToolTip.ShowDelay="1000" ToolTip.Tip="Three random cards in the opponent's hand are visible."/>
                    <CheckBox Grid.Row="7" Grid.Column="1" x:Name="HoneycombRule_ThreeOpen" Tag="ThreeOpen" Checked="HoneycombRule_Changed" Unchecked="HoneycombRule_Changed" ToolTip.ShowDelay="1000" ToolTip.Tip="Three random cards in the opponent's hand are visible."/>
                    <TextBlock x:Name="RuleLabel_ThreeOpen" Grid.Row="7" Grid.Column="2" Text="Scouting Party" Foreground="#1A1A1A" VerticalAlignment="Center" Margin="10,4,0,4" ToolTip.ShowDelay="1000" ToolTip.Tip="Three random cards in the opponent's hand are visible."/>

                    <CheckBox Grid.Row="8" Grid.Column="0" x:Name="Ban_Swap" Tag="Swap" Checked="BanRule_Changed" Unchecked="BanRule_Changed" ToolTip.ShowDelay="1000" ToolTip.Tip="One card from each player's hand is randomly swapped at the start of the match."/>
                    <CheckBox Grid.Row="8" Grid.Column="1" x:Name="HoneycombRule_Swap" Tag="Swap" Checked="HoneycombRule_Changed" Unchecked="HoneycombRule_Changed" ToolTip.ShowDelay="1000" ToolTip.Tip="One card from each player's hand is randomly swapped at the start of the match."/>
                    <TextBlock x:Name="RuleLabel_Swap" Grid.Row="8" Grid.Column="2" Text="Nectar Exchange" Foreground="#1A1A1A" VerticalAlignment="Center" Margin="10,4,0,4" ToolTip.ShowDelay="1000" ToolTip.Tip="One card from each player's hand is randomly swapped at the start of the match."/>

                    <CheckBox Grid.Row="9" Grid.Column="0" x:Name="Ban_Order" Tag="Order" Checked="BanRule_Changed" Unchecked="BanRule_Changed" ToolTip.ShowDelay="1000" ToolTip.Tip="Cards must be played in the exact order they were drawn."/>
                    <CheckBox Grid.Row="9" Grid.Column="1" x:Name="HoneycombRule_Order" Tag="Order" Checked="HoneycombRule_Changed" Unchecked="HoneycombRule_Changed" ToolTip.ShowDelay="1000" ToolTip.Tip="Cards must be played in the exact order they were drawn."/>
                    <TextBlock x:Name="RuleLabel_Order" Grid.Row="9" Grid.Column="2" Text="Hierarchy" Foreground="#1A1A1A" VerticalAlignment="Center" Margin="10,4,0,4" ToolTip.ShowDelay="1000" ToolTip.Tip="Cards must be played in the exact order they were drawn."/>

                    <CheckBox Grid.Row="10" Grid.Column="0" x:Name="Ban_Chaos" Tag="Chaos" Checked="BanRule_Changed" Unchecked="BanRule_Changed" ToolTip.ShowDelay="1000" ToolTip.Tip="Cards are randomly selected and forced to be played each turn."/>
                    <CheckBox Grid.Row="10" Grid.Column="1" x:Name="HoneycombRule_Chaos" Tag="Chaos" Checked="HoneycombRule_Changed" Unchecked="HoneycombRule_Changed" ToolTip.ShowDelay="1000" ToolTip.Tip="Cards are randomly selected and forced to be played each turn."/>
                    <TextBlock x:Name="RuleLabel_Chaos" Grid.Row="10" Grid.Column="2" Text="Frenzy" Foreground="#1A1A1A" VerticalAlignment="Center" Margin="10,4,0,4" ToolTip.ShowDelay="1000" ToolTip.Tip="Cards are randomly selected and forced to be played each turn."/>

                    <CheckBox Grid.Row="11" Grid.Column="0" x:Name="Ban_BombShelter" Tag="BombShelter" Checked="BanRule_Changed" Unchecked="BanRule_Changed" ToolTip.ShowDelay="1000" ToolTip.Tip="Each player's first card played remains face-down for 3 turns before flipping automatically."/>
                    <CheckBox Grid.Row="11" Grid.Column="1" x:Name="HoneycombRule_BombShelter" Tag="BombShelter" Checked="HoneycombRule_Changed" Unchecked="HoneycombRule_Changed" ToolTip.ShowDelay="1000" ToolTip.Tip="Each player's first card played remains face-down for 3 turns before flipping automatically."/>
                    <TextBlock x:Name="RuleLabel_BombShelter" Grid.Row="11" Grid.Column="2" Text="Capped Brood" Foreground="#1A1A1A" VerticalAlignment="Center" Margin="10,4,0,4" ToolTip.ShowDelay="1000" ToolTip.Tip="Each player's first card played remains face-down for 3 turns before flipping automatically."/>

                    <CheckBox Grid.Row="12" Grid.Column="0" x:Name="Ban_Reverse" Tag="Reverse" Checked="BanRule_Changed" Unchecked="BanRule_Changed" ToolTip.ShowDelay="1000" ToolTip.Tip="Lower stats capture higher stats."/>
                    <CheckBox Grid.Row="12" Grid.Column="1" x:Name="HoneycombRule_Reverse" Tag="Reverse" Checked="HoneycombRule_Changed" Unchecked="HoneycombRule_Changed" ToolTip.ShowDelay="1000" ToolTip.Tip="Lower stats capture higher stats."/>
                    <TextBlock x:Name="RuleLabel_Reverse" Grid.Row="12" Grid.Column="2" Text="Inversion" Foreground="#1A1A1A" VerticalAlignment="Center" Margin="10,4,0,4" ToolTip.ShowDelay="1000" ToolTip.Tip="Lower stats capture higher stats."/>

                    <CheckBox Grid.Row="13" Grid.Column="0" x:Name="Ban_SuddenDeath" Tag="SuddenDeath" Checked="BanRule_Changed" Unchecked="BanRule_Changed" ToolTip.ShowDelay="1000" ToolTip.Tip="If the match ends in a draw, the cards currently owned by each player become their new hand and the match restarts immediately."/>
                    <CheckBox Grid.Row="13" Grid.Column="1" x:Name="HoneycombRule_SuddenDeath" Tag="SuddenDeath" Checked="HoneycombRule_Changed" Unchecked="HoneycombRule_Changed" ToolTip.ShowDelay="1000" ToolTip.Tip="If the match ends in a draw, the cards currently owned by each player become their new hand and the match restarts immediately."/>
                    <TextBlock x:Name="RuleLabel_SuddenDeath" Grid.Row="13" Grid.Column="2" Text="Swarm to the Death" Foreground="#1A1A1A" VerticalAlignment="Center" Margin="10,4,0,4" ToolTip.ShowDelay="1000" ToolTip.Tip="If the match ends in a draw, the cards currently owned by each player become their new hand and the match restarts immediately."/>
                </Grid>

                <TextBlock x:Name="SillyBeeWarning" Text="You cannot blacklist every game, silly bee." FontSize="11" FontWeight="SemiBold" Foreground="#E53935" IsVisible="False" Margin="0,10,0,0"/>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,20,0,0">
            <Button x:Name="CancelButton" Content="Cancel" Click="Cancel_Click" Width="80" HorizontalContentAlignment="Center" Classes="light-secondary" />
            <Button x:Name="OkButton" Content="OK" Click="OK_Click" Width="80" HorizontalContentAlignment="Center" Classes="light-primary" />
        </StackPanel>
    </Grid>
</UserControl>
